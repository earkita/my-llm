#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(dirname -- "$script_dir")
python="$repo_root/.venv/bin/python"
driver="$script_dir/benchmark-vllm-profile.py"

usage() {
  cat <<'EOF'
Usage:
  scripts/bench TARGET [SCENARIO] [--direct|--raw] [OPTIONS]
  scripts/bench --list

TARGET may be an alias exposed by the active LiteLLM profile or a deployment
profile. A bare profile name resolves below profiles/production; directory
forms such as dev/MODEL and profiles/dev/MODEL are also accepted, with an
optional .json suffix. Alias targets use LiteLLM by default. Profile targets
use vLLM's OpenAI Chat API directly. --direct bypasses LiteLLM for an alias
while preserving its sampling parameters. --raw measures greedy
/v1/completions with ignore_eos for fixed-length engine throughput.

Scenarios: all (default), interactive, prefill, decode, prefix, pool

Examples:
  scripts/bench qwen3.8-flash-next-fast decode
  scripts/bench qwen3.8-27b-workers-fast prefill
  scripts/bench qwen3.8-27b-workers-fast decode --direct --worker-rank 2
  scripts/bench glm-5.3-flash-high decode --raw
  scripts/bench glm53-flash decode --raw
  scripts/bench dev/glm53-flash-new decode --raw
EOF
}

[[ -x $python ]] || {
  printf 'Repository Python is unavailable: %s\n' "$python" >&2
  exit 1
}

if (($# == 0)) || [[ ${1:-} == --help || ${1:-} == -h ]]; then
  usage
  exit 0
fi
if [[ $1 == --list ]]; then
  shift
  (($# == 0)) || {
    printf '%s\n' '--list does not accept additional arguments.' >&2
    exit 2
  }
  exec "$python" "$driver" --list-litellm-models
fi

target=$1
shift
scenario=all
if (($# > 0)) && [[ $1 != -* ]]; then
  scenario=$1
  shift
fi

target_without_suffix=${target%.json}
if [[ $target == /* || $target == */* || -f "$repo_root/profiles/production/${target_without_suffix}.json" ]]; then
  selector=(--profile "$target")
else
  selector=(--litellm-model "$target")
fi

exec "$python" "$driver" \
  "${selector[@]}" \
  --scenario "$scenario" \
  "$@"
