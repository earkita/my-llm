#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(dirname -- "$script_dir")
python="$repo_root/.venv/bin/python"
driver="$script_dir/benchmark-vllm-profile.py"

usage() {
  cat <<'EOF'
Usage:
  scripts/bench MODEL [SCENARIO] [--direct|--raw] [OPTIONS]
  scripts/bench --list

MODEL is an alias exposed by the active LiteLLM profile. The default measures
the production LiteLLM path. --direct sends the same workload dimensions and
alias sampling parameters through vLLM's OpenAI Chat API. For an
Anthropic-backed alias this bypasses the proxy but does not duplicate the
Anthropic provider protocol. --raw measures greedy /v1/completions with
ignore_eos for fixed-length engine throughput.

Scenarios: all (default), interactive, prefill, decode, prefix, pool

Examples:
  scripts/bench qwen3.8-flash-next-fast decode
  scripts/bench qwen3.8-27b-workers-fast prefill
  scripts/bench qwen3.8-27b-workers-fast decode --direct --worker-rank 2
  scripts/bench glm-5.3-flash-high decode --raw
EOF
}

[[ -x $python ]] || {
  printf 'Repository Python is unavailable: %s\n' "$python" >&2
  exit 1
}

if (($# == 0)) || [[ ${1:-} == --help || ${1:-} == -h ]]; then
  usage
  exit 0
fi
if [[ $1 == --list ]]; then
  shift
  (($# == 0)) || {
    printf '%s\n' '--list does not accept additional arguments.' >&2
    exit 2
  }
  exec "$python" "$driver" --list-litellm-models
fi

model=$1
shift
scenario=all
if (($# > 0)) && [[ $1 != -* ]]; then
  scenario=$1
  shift
fi

exec "$python" "$driver" \
  --litellm-model "$model" \
  --scenario "$scenario" \
  "$@"
