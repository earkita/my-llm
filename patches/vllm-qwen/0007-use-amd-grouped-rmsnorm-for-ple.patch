+def test_ple_norm_uses_amd_grouped_kernel(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    layer = ple_layer_module.Qwen4ExpPLELayer.__new__(
+        ple_layer_module.Qwen4ExpPLELayer
+    )
+    torch.nn.Module.__init__(layer)
+    layer.hc_count = 4
+    norm = SimpleNamespace(weight=torch.empty(32), eps=1e-6)
+    hidden_states = torch.empty(3, 4, 8)
+    expected = torch.full_like(hidden_states.flatten(-2), 7)
+    calls: list[tuple[torch.Tensor, torch.Tensor, float, int]] = []
+
+    def fake_grouped_norm(
+        values: torch.Tensor,
+        weight: torch.Tensor,
+        eps: float,
+        groups: int,
+    ) -> torch.Tensor:
+        calls.append((values, weight, eps, groups))
+        return expected
+
+    monkeypatch.setattr(
+        ple_layer_module, "grouped_gemma_rmsnorm", fake_grouped_norm
+    )
+
+    output = layer._apply_norm(norm, hidden_states)
+
+    assert output.shape == hidden_states.shape
+    assert len(calls) == 1
+    values, weight, eps, groups = calls[0]
+    assert values.shape == (3, 32)
+    assert values.data_ptr() == hidden_states.data_ptr()
+    assert weight is norm.weight
+    assert eps == norm.eps
+    assert groups == 4
+    torch.testing.assert_close(output.flatten(-2), expected)
+
+
