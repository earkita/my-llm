+@pytest.mark.parametrize(
+    ("ring_pools", "expected_match"), [(1, False), (2, False), (3, True)]
+)
+def test_k7_rejected_draft_redo_needs_three_pool_ring(
+    ring_pools, expected_match
+):
+    """K=7 needs three kpool-sized ring segments across a rejected boundary."""
+    pool, num_spec, page, nblk = 4, 7, 64, 2
+    ring = ring_pools * pool
+    block = 1
+    dev = "cuda"
+    torch.manual_seed(17)
+
+    true_k = torch.randn(8, HEAD_DIM, dtype=torch.bfloat16, device=dev)
+    true_score = torch.randn_like(true_k)
+    draft_k = torch.randn(num_spec, HEAD_DIM, dtype=torch.bfloat16, device=dev)
+    draft_score = torch.randn_like(draft_k)
+    ape = torch.randn(pool, HEAD_DIM, dtype=torch.float32, device=dev)
+
+    kv_ref = torch.zeros(nblk, page, HEAD_DIM + 4, dtype=torch.uint8, device=dev)
+    kpool_compress_and_write_cache(
+        kv_ref,
+        true_k[4:8].view(1, pool, HEAD_DIM),
+        true_score[4:8].view(1, pool, HEAD_DIM),
+        ape,
+        torch.tensor([1], dtype=torch.int64, device=dev),
+        pool_size=pool,
+        head_dim=HEAD_DIM,
+        round_scale=ROUND_SCALE,
+    )
+
+    kv = torch.zeros_like(kv_ref)
+    tail = torch.zeros(nblk, 2, ring, HEAD_DIM, dtype=torch.bfloat16, device=dev)
+
+    def step(positions, keys, scores, completion_locs):
+        pos = torch.tensor([positions], dtype=torch.int32, device=dev)
+        tail_slots = block * ring + pos % ring
+        kpool_decode_update_and_maybe_write_cache_batched(
+            kv,
+            tail,
+            tail_slots,
+            keys.view(1, -1, HEAD_DIM),
+            scores.view(1, -1, HEAD_DIM),
+            ape,
+            torch.tensor([completion_locs], dtype=torch.int32, device=dev),
+            pos,
+            pool,
+            HEAD_DIM,
+            round_scale=ROUND_SCALE,
+        )
+
+    step([4], true_k[4], true_score[4], [-1])
+    step([5], true_k[5], true_score[5], [-1])
+
+    # Position 7 is a wrong draft that completes the pool. Draft rows through
+    # 13 are stashed before rejection is known; position 11 deliberately has
+    # no completion location so cache slot 1 is only written for pool [4..7].
+    step(
+        list(range(6, 14)),
+        torch.cat([true_k[6:7], draft_k]),
+        torch.cat([true_score[6:7], draft_score]),
+        [-1, 1, -1, -1, -1, -1, -1, -1],
+    )
+    step([7], true_k[7], true_score[7], [1])
+    assert torch.equal(kv, kv_ref) is expected_match
+
