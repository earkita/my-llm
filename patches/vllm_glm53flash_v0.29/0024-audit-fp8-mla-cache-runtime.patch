diff --git a/vllm/model_executor/layers/attention/mla_attention.py b/vllm/model_executor/layers/attention/mla_attention.py
--- a/vllm/model_executor/layers/attention/mla_attention.py
+++ b/vllm/model_executor/layers/attention/mla_attention.py
@@ -1280,6 +1280,43 @@ class MLAAttention(nn.Module, AttentionLayerBase):
         if not should_load_quant_weights(quant_method):
             set_default_quant_scales(self, register_buffer=False)
 
+        if is_quantized_kv_cache(self.kv_cache_dtype):
+            q_scale = float(self._q_scale_float)
+            k_scale = float(self._k_scale_float)
+            if not (
+                math.isfinite(q_scale)
+                and q_scale > 0.0
+                and math.isfinite(k_scale)
+                and k_scale > 0.0
+            ):
+                raise ValueError(
+                    "MLA FP8 KV cache requires finite positive q/k scales, "
+                    f"got q_scale={q_scale}, k_scale={k_scale}."
+                )
+            scale_source = (
+                "checkpoint" if should_load_quant_weights(quant_method) else "unit"
+            )
+            logger.info_once(
+                "MLA KV quantization active: dtype=%s backend=%s "
+                "q_scale=%g k_scale=%g scale_source=%s "
+                "q_scale_tensor=%s@%s k_scale_tensor=%s@%s",
+                self.kv_cache_dtype,
+                self.attn_backend.get_name(),
+                q_scale,
+                k_scale,
+                scale_source,
+                self._q_scale.dtype,
+                self._q_scale.device,
+                self._k_scale.dtype,
+                self._k_scale.device,
+            )
+            if scale_source == "unit":
+                logger.warning_once(
+                    "The checkpoint has no calibrated MLA KV scales; FP8 E4M3 "
+                    "uses explicit unit q/k scales. Validate output quality "
+                    "against BF16 before production use."
+                )
+
     def get_attn_backend(self) -> type[AttentionBackend]:
         return self.attn_backend
 
