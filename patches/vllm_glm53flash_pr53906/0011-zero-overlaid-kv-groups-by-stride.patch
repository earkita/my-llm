+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+def test_overlaid_groups_may_share_base_address_with_different_block_strides():
+    """A shared raw pool can expose layer-outer target and draft views from
+    the same base address even though their per-layer block strides differ."""
+    device = torch.device("cuda")
+    num_blocks = 4
+    spec = SlidingWindowSpec(
+        block_size=2,
+        num_kv_heads=1,
+        head_size=1,
+        dtype=torch.uint8,
+        sliding_window=4,
+    )
+    raw = torch.ones(32, dtype=torch.uint8, device=device)
+    target = torch.as_strided(raw, (num_blocks, 1, 2, 2), (4, 4, 2, 1))
+    draft = torch.as_strided(raw, (num_blocks, 1, 2, 2), (8, 4, 2, 1))
+    assert target.data_ptr() == draft.data_ptr()
+    assert target.stride(0) != draft.stride(0)
+
+    zeroer = KVBlockZeroer(
+        device,
+        attn_groups_iter=[
+            AttentionGroup(None, ["target"], spec, 0),
+            AttentionGroup(None, ["draft"], spec, 1),
+        ],
+        kernel_block_sizes=[2, 2],
+        static_forward_context={
+            "target": SimpleNamespace(kv_cache=target),
+            "draft": SimpleNamespace(kv_cache=draft),
+        },
+        num_blocks=num_blocks,
+    )
+
+    zeroer.zero_block_ids([1])
+    torch.accelerator.synchronize()
+
+    assert (raw[4:12] == 0).all()
+    assert (raw[:4] == 1).all()
+    assert (raw[12:] == 1).all()
+
+
