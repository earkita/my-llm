+        if layer is None or residual is None or post is None or comb is None:
+            raise RuntimeError(
+                "DFlash auxiliary capture requires a completed GLM mHC layer"
+            )
+        mhc_output = layer.hc_post(hidden_states, residual, post, comb)
+        aux_hidden_states.append(hc_contract(mhc_output, layer.n))
+
