+def test_get_kv_cache_config_glm5_with_dflash_and_hidden_states():
+    """Keep GLM's aliased MLA/indexer/Mamba layout when DFlash adds a
+    non-causal sliding-window group and auxiliary hidden-state caches."""
+    model_config = ModelConfig(max_model_len=8192)
+    vllm_config = VllmConfig(model_config=model_config)
+    vllm_config.cache_config.kv_cache_layout = "LBHNC"
+    vllm_config.speculative_config = SimpleNamespace(use_dflash=lambda: True)
+
+    kv_cache_spec, _ = _glm5_like_kv_cache_spec()
+    for i in range(5):
+        kv_cache_spec[f"dflash_head.model.layers.{i}.self_attn.attn"] = (
+            SlidingWindowSpec(
+                block_size=1024,
+                num_kv_heads=1,
+                head_size=128,
+                dtype=torch.bfloat16,
+                sliding_window=8192,
+            )
+        )
+    kv_cache_spec["extract_hidden_states"] = HiddenStateCacheSpec(
+        block_size=1024,
+        num_kv_heads=1,
+        head_size=6144,
+        dtype=torch.bfloat16,
+    )
+
+    groups = kv_cache_utils.get_kv_cache_groups(vllm_config, kv_cache_spec)
+    layout = kv_cache_utils._glm5_next_tensor_layout(groups)
+    assert layout is not None
+    extra_groups = layout[8]
+    draft_group = next(g for g in extra_groups if g.is_eagle_group)
+    assert len(draft_group.layer_names) == 5
+    assert all(name.startswith("dflash_head.") for name in draft_group.layer_names)
+    assert any(
+        isinstance(group.kv_cache_spec, HiddenStateCacheSpec)
+        for group in extra_groups
+    )
+
+    target_bytes = 11 * kv_cache_spec["layers.3.attn"].page_size_bytes + 11 * (
+        kv_cache_spec["layers.3.indexer"].page_size_bytes
+    )
+    draft_bytes = sum(
+        kv_cache_spec[name].page_size_bytes for name in draft_group.layer_names
+    )
+    bytes_per_block = kv_cache_utils._pool_bytes_per_block(groups)
+    assert bytes_per_block == max(target_bytes, draft_bytes)
+
+    config = kv_cache_utils.get_kv_cache_config_from_groups(
+        vllm_config, groups, bytes_per_block * 100
+    )
+    assert config.num_blocks == 100
+    tensors = _tensor_by_layer(config)
+    assert set(kv_cache_spec) == set(tensors)
+    assert {tensor.size for tensor in config.kv_cache_tensors} == {
+        bytes_per_block * 100
+    }
+
+
