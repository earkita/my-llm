+        return (ctypes.c_long * N)(*sp), (ctypes.c_long * N)(*fp)
+
+    def should(self, x: torch.Tensor) -> bool:
+        if self.disabled or x.dtype not in _DTYPE or not x.is_contiguous():
+            return False
+        n = x.numel() * x.element_size()
+        if n > self.max_bytes:
