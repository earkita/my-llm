diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -120,14 +120,19 @@ void ggml_cuda_set_device(int device) {
     // translate the (possibly virtual) device id to the physical CUDA device that backs it
     const int physical_device = ggml_cuda_get_physical_device(device);
 
+#if defined(GGML_USE_HIP)
+    // hipGetDevice() can report a matching ordinal on a fresh worker thread
+    // whose device context is not initialized. Always establish the context
+    // before a HIP operation while preserving virtual-to-physical mapping.
+    CUDA_CHECK(cudaSetDevice(physical_device));
+#else
     int current_device;
     CUDA_CHECK(cudaGetDevice(&current_device));
 
-    if (physical_device == current_device) {
-        return;
+    if (physical_device != current_device) {
+        CUDA_CHECK(cudaSetDevice(physical_device));
     }
-
-    CUDA_CHECK(cudaSetDevice(physical_device));
+#endif
 }
 
 int ggml_cuda_get_device() {
@@ -2438,6 +2443,7 @@ static void ggml_backend_cuda_set_tensor_async(ggml_backend_t backend, ggml_tens
 
     GGML_ASSERT(buf->buft == ggml_backend_cuda_buffer_type(cuda_ctx->device) && "unsupported buffer type");
 
+    ggml_cuda_set_device(cuda_ctx->device);
     CUDA_CHECK(cudaMemcpyAsync((char *) tensor->data + offset, data, size, cudaMemcpyHostToDevice, cuda_ctx->stream()));
 }
 
