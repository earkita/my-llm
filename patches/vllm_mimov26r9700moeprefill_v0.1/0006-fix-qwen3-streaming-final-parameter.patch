-        remaining = _PARAM_RE.sub("", raw_args)
+    remaining = _PARAM_RE.sub("", raw_args)
+    # Treat </function> as an implicit end for the last parameter.  Qwen-family
+    # models occasionally omit only the final </parameter> while otherwise
+    # producing a complete tool call.  During streaming we may already have
+    # emitted a safe prefix such as {"command": "...; dropping that parameter
+    # during the final conversion would leave clients with invalid JSON.
+    #
+    # Complete parameters have already been removed above, so accepting the
+    # remaining open parameter in the final pass is unambiguous and matches
+    # the existing recovery for a missing close before the next parameter.
+    if partial or remaining.strip():
         m = _PARTIAL_PARAM_RE.search(remaining)
         if m:
             name = m.group(1)

