+        """The function close must finalize an unterminated last parameter."""
+        chunks = [
+            "<tool_call>\n",
+            "<function=Bash>\n",
+            '<parameter=command>grep -n "const mediaMode\\|setAudioOnly" index.html',
+            "</function>\n",
+            "</tool_call>",
+        ]
+
+        results = simulate_tool_streaming(parser, mock_request, chunks)
+
+        args_text = collect_tool_arguments(results)
+        assert json.loads(args_text) == {
