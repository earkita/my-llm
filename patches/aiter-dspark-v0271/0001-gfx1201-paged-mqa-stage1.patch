+++ b/aiter/ops/triton/_triton_kernels/attention/pa_mqa_logits.py
@@ -311,6 +311,143 @@ def _deepgemm_fp8_paged_mqa_logits_stage1(
         )
 
 
+@triton.jit
+def _deepgemm_fp8_paged_mqa_logits_stage1_preshuffle(
+    batch_size,
+    next_n,
+    heads_num,
+    Q_buffer,
+    stride_q_batch: tl.int64,
+    stride_q_next_n: tl.int64,
+    stride_q_heads: tl.int64,
+    KV_buffer,
+    stride_k_block: tl.int64,
+    scale_buffer,
+    stride_scale_block: tl.int64,
+    context_len_ptr,
+    stride_context_batch: tl.int64,
+    stride_context_next: tl.int64,
+    kv_indices,
+    stride_kv_indices: tl.int64,
+    weights,
+    stride_w_batch: tl.int64,
+    Out_buffer,
+    stride_out_heads: tl.int64,
+    stride_out_batch: tl.int64,
+    max_model_len,
+    max_blk_len,
+    num_blocks,
+    ChunkQ: tl.constexpr,
+    ChunkK: tl.constexpr,
+    HiddenDim: tl.constexpr,
+    KVBlockSize: tl.constexpr,
+    BlockTileSize: tl.constexpr,
+    HeadTileSize: tl.constexpr,
+    ContextLens2D: tl.constexpr,
+    SplitKV: tl.constexpr = 1,
+):
+    pid = tl.program_id(0)
+    num_block_q_head = tl.cdiv(heads_num, ChunkQ)
+
+    pid_q_head, remain_pid = pid % num_block_q_head, pid // num_block_q_head
+    pid_next_n, remain_pid = remain_pid % next_n, remain_pid // next_n
+    pid_batch, pid_split_kv = remain_pid % batch_size, remain_pid // batch_size
+
+    if ContextLens2D:
+        context_length = tl.load(
+            context_len_ptr
+            + pid_batch * stride_context_batch
+            + pid_next_n * stride_context_next
+        )
+    else:
+        final_context_length = tl.load(
+            context_len_ptr + pid_batch * stride_context_batch
+        )
+        context_length = final_context_length - next_n + pid_next_n + 1
+    context_length = tl.maximum(context_length, 0)
+
+    context_chunk_num = tl.cdiv(context_length, ChunkK)
+    split_context_chunk_num = tl.cdiv(context_chunk_num, SplitKV)
+    split_context_start = (pid_split_kv * split_context_chunk_num) * ChunkK
+    split_context_length = min(
+        context_length - split_context_start, split_context_chunk_num * ChunkK
+    )
+
+    head_offsets = tl.arange(0, HiddenDim)
+    q = tl.load(
+        Q_buffer
+        + pid_batch * stride_q_batch
+        + pid_next_n * stride_q_next_n
+        + ((pid_q_head * ChunkQ + tl.arange(0, ChunkQ)) * stride_q_heads)[:, None]
+        + head_offsets[None, :],
+    )
+    scale_weight = tl.load(
+        weights
+        + (pid_batch * next_n + pid_next_n) * stride_w_batch
+        + pid_q_head * ChunkQ
+        + tl.arange(0, ChunkQ)
+    )
+    tiled_head_offsets = (
+        head_offsets // HeadTileSize * HeadTileSize * BlockTileSize
+        + head_offsets % HeadTileSize
+    )
+
+    for context_idx in range(
+        split_context_start, split_context_start + split_context_length, ChunkK
+    ):
+        token_offsets = context_idx + tl.arange(0, ChunkK)
+        valid_token = token_offsets < context_length
+        logical_block = token_offsets // KVBlockSize
+        valid_page = valid_token & (logical_block < max_blk_len)
+        physical_block = tl.load(
+            kv_indices + pid_batch * stride_kv_indices + logical_block,
+            mask=valid_page,
+            other=-1,
+        )
+        valid_block = valid_page & (physical_block >= 0) & (
+            physical_block < num_blocks
+        )
+        safe_block = tl.where(valid_block, physical_block, 0).to(tl.int64)
+        token_in_block = token_offsets % KVBlockSize
+        token_tile = token_in_block // BlockTileSize
+        token_in_tile = token_in_block % BlockTileSize
+        k_base = (
+            safe_block * stride_k_block
+            + token_tile * BlockTileSize * HiddenDim
+            + token_in_tile * HeadTileSize
+        )
+        k = tl.load(
+            KV_buffer + k_base[:, None] + tiled_head_offsets[None, :],
+            mask=valid_block[:, None],
+            other=0.0,
+        )
+        k_scale = tl.load(
+            scale_buffer
+            + safe_block * stride_scale_block
+            + token_in_block,
+            mask=valid_block,
+            other=0.0,
+        )
+
+        o = tl.dot(q, k.T)
+        o = o * k_scale[None, :]
+        o = tl.maximum(o, 0.0)
+        o = o * scale_weight[:, None]
+        o = tl.where(valid_block[None, :], o, float("-inf"))
+
+        output_offsets = (
+            (pid_batch * next_n + pid_next_n) * stride_out_batch
+            + (pid_q_head * ChunkQ + tl.arange(0, ChunkQ)[:, None, None])
+            * stride_out_heads
+            + token_offsets[None, None, :]
+        )
+        tl.store(
+            Out_buffer + output_offsets,
+            o[:, None, :],
+            mask=(token_offsets < max_model_len)[None, None, :],
+        )
+
+
