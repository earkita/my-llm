@@ -253,6 +255,99 @@ def deepgemm_fp8_paged_mqa_logits_stage1(
     )
 
 
+def deepgemm_fp8_paged_mqa_logits_stage1_preshuffle(
+    q_fp8: torch.Tensor,
+    kv_cache_fp8: torch.Tensor,
+    weights: torch.Tensor,
+    out_qk: torch.Tensor,
+    context_lens: torch.Tensor,
+    kv_indices: torch.Tensor,
+    max_model_len: int,
+    ChunkQ: int = 64,
+    ChunkK: int = 256,
+    TotalCuCount: int | None = None,
+    WavePerEU: int = 2,
+):
+    if get_gfx() != "gfx1201":
+        raise RuntimeError("preshuffled stage1 is currently limited to gfx1201")
+    if TotalCuCount is None:
+        TotalCuCount = get_num_sms()
+
+    batch_size, next_n, heads, hidden_dim = q_fp8.size()
+    num_blocks, block_size, num_kv_heads, index_dim = kv_cache_fp8.size()
+    if block_size not in (64, 256) or hidden_dim != 128 or num_kv_heads != 1:
+        raise ValueError(
+            "gfx1201 preshuffled stage1 requires cache block_size in "
+            "{64, 256}, "
+            f"hidden_dim=128, num_kv_heads=1; got {kv_cache_fp8.shape}"
+        )
+    if index_dim != hidden_dim + 4:
+        raise ValueError(f"expected index_dim={hidden_dim + 4}, got {index_dim}")
+    if context_lens.dim() not in (1, 2):
+        raise ValueError(
+            f"context_lens must be 1D or 2D, got {context_lens.shape}"
+        )
+    if context_lens.dim() == 2 and context_lens.shape != (batch_size, next_n):
+        raise ValueError(
+            "2D context_lens must have shape "
+            f"{(batch_size, next_n)}, got {context_lens.shape}"
+        )
+    if kv_indices.dim() != 2 or kv_indices.shape[0] != batch_size:
+        raise ValueError(
+            f"kv_indices must have shape [B, pages], got {kv_indices.shape}"
+        )
+    if heads % ChunkQ != 0:
+        raise ValueError(f"heads={heads} must be divisible by ChunkQ={ChunkQ}")
+
+    tile_q_count = batch_size * next_n * (heads // ChunkQ)
+    split_kv = (max(1, TotalCuCount // tile_q_count) + 4) // 5 * 5 * WavePerEU
+    cache_flat = kv_cache_fp8.view(num_blocks, -1)
+    value_bytes = block_size * hidden_dim
+    kv_cache_value = cache_flat[:, :value_bytes].view(dtypes.fp8)
+    kv_cache_scale = cache_flat[:, value_bytes:].view(torch.float32)
+    max_blk_len = kv_indices.shape[1]
+
+    config = {
+        "ChunkQ": ChunkQ,
+        "ChunkK": ChunkK,
+        "HiddenDim": hidden_dim,
+        "KVBlockSize": block_size,
+        "BlockTileSize": 16,
+        "HeadTileSize": 16,
+        "ContextLens2D": context_lens.dim() == 2,
+        "SplitKV": split_kv,
+    }
+    grid = (batch_size * next_n * (heads // ChunkQ * split_kv),)
+    _deepgemm_fp8_paged_mqa_logits_stage1_preshuffle[grid](
+        batch_size,
+        next_n,
+        heads,
+        q_fp8,
+        q_fp8.stride(0),
+        q_fp8.stride(1),
+        q_fp8.stride(2),
+        kv_cache_value,
+        kv_cache_value.stride(0),
+        kv_cache_scale,
+        kv_cache_scale.stride(0),
+        context_lens,
+        context_lens.stride(0),
+        context_lens.stride(1) if context_lens.dim() == 2 else 0,
+        kv_indices,
+        kv_indices.stride(0),
+        weights,
+        weights.stride(0),
+        out_qk,
+        out_qk.stride(0),
+        out_qk.stride(1),
+        max_model_len,
+        max_blk_len,
+        num_blocks,
+        waves_per_eu=WavePerEU,
+        **config,
+    )
+
+
