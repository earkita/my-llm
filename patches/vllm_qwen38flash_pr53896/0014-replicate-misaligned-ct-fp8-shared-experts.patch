+def get_quantized_linear_group_size(
+    quant_config: "QuantizationConfig | None",
+    layer_name: str,
+) -> int | None:
+    """Return the output-shard alignment required by a quantized linear.
+
+    Quark OCP MX weights use their group size. Compressed-tensors block FP8
+    weights use the output-axis block size. Qwen shared experts use this value
+    to replicate a small projection when a TP shard would split quantization
+    groups and make its checkpoint scales impossible to apply exactly.
+    """
+    quark_group_size = get_quark_ocp_mx_group_size(quant_config, layer_name)
+    if quark_group_size is not None:
+        return quark_group_size
+    if quant_config is None:
+        return None
+
+    from torch import nn
+
+    from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors import (  # noqa: E501
+        CompressedTensorsConfig,
+    )
+
+    if not isinstance(quant_config, CompressedTensorsConfig):
+        return None
+
+    scheme = quant_config.get_scheme_dict(nn.Linear(1, 1), layer_name)
+    weight_quant = scheme.get("weights") if scheme is not None else None
+    if weight_quant is None:
+        return None
+
+    block_structure = getattr(weight_quant, "block_structure", None)
+    if block_structure:
+        return int(block_structure[0])
+
+    group_size = getattr(weight_quant, "group_size", None)
+    return int(group_size) if group_size is not None else None
+
