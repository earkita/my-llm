+def test_ple_fp8_embedding_dequantizes_with_checkpoint_scale() -> None:
+    layer = ple_layer_module.Qwen4ExpPLELayer.__new__(
+        ple_layer_module.Qwen4ExpPLELayer
+    )
+    torch.nn.Module.__init__(layer)
+    layer.ple_embedding = torch.nn.Module()
+    layer.ple_embedding.ngram_embedding = torch.nn.Module()
+    layer.ple_embedding.ngram_embedding.weight_scale = torch.nn.Parameter(
+        torch.tensor([0.25], dtype=torch.bfloat16),
+        requires_grad=False,
+    )
+    quantized = torch.tensor(
+        [[4.0, 8.0], [16.0, 32.0]], dtype=torch.float8_e4m3fn
+    )
+
+    output = layer._dequantize_embeddings(quantized, torch.bfloat16)
+
+    assert output.dtype == torch.bfloat16
+    torch.testing.assert_close(
+        output,
+        torch.tensor([[1.0, 2.0], [4.0, 8.0]], dtype=torch.bfloat16),
+    )
+
