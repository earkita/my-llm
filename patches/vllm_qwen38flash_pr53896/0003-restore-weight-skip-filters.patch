+@pytest.mark.cpu_test
+def test_module_skips_configured_prefixes_and_substrings():
+    mod = torch.nn.Module()
+    mod.kept = torch.nn.Parameter(torch.zeros(2))
+
+    weights = [
+        ("visual.weight", torch.ones(2)),
+        ("model.mtp.weight", torch.ones(2)),
+        ("kept", torch.ones(2)),
+    ]
+    loaded = AutoWeightsLoader(
+        mod,
+        skip_prefixes=["visual."],
+        skip_substrs=["mtp."],
+    ).load_weights(iter(weights))
+
+    assert loaded == {"kept"}
+    assert torch.all(mod.kept == 1.0)
+
