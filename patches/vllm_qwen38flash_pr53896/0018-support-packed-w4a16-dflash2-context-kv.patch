+def test_packed_projection_materializes_dense_kv_rows():
+    class PackedProjection(torch.nn.Module):
+        input_size_per_partition = 4
+        orig_dtype = torch.float32
+
+        def __init__(self) -> None:
+            super().__init__()
+            self.weight_packed = torch.nn.Parameter(
+                torch.zeros(1, dtype=torch.int32), requires_grad=False
+            )
+            self.dense = torch.arange(24, dtype=torch.float32).reshape(6, 4)
+
+        def forward(self, inputs: torch.Tensor):
+            return inputs @ self.dense.t(), None
+
+    projection = PackedProjection()
+
+    actual = _dflash_kv_weight_rows(projection, q_size=2)
+
+    torch.testing.assert_close(actual, projection.dense[2:])
+
