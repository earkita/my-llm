         return hidden_states, residual
 
 
+_DFLASH_FP8 = (torch.float8_e4m3fn, torch.float8_e4m3fnuz)
+
+
+def _dflash_kv_weight_rows(qkv_proj, q_size: int) -> torch.Tensor:
+    """Return dense K/V rows for float and packed DFlash projections.
+
+    Packed compressed-tensors W4A16 projections do not expose a dense
+    ``weight`` parameter.  Running the projection over an identity matrix uses
+    its selected quantization kernel, including the checkpoint scales, and
+    produces the exact dense rows needed by the fused context-KV precompute.
+    """
+    weight = getattr(qkv_proj, "weight", None)
+    if (
+        weight is not None
+        and weight.dim() == 2
+        and weight.is_floating_point()
+        and weight.dtype not in _DFLASH_FP8
+    ):
+        return weight[q_size:]
+    dtype = getattr(qkv_proj, "orig_dtype", torch.bfloat16)
+    device = (
+        weight.device
+        if weight is not None
+        else next(qkv_proj.parameters()).device
+    )
+    identity = torch.eye(
+        qkv_proj.input_size_per_partition,
+        dtype=dtype,
+        device=device,
+    )
+    output = qkv_proj(identity)
+    if isinstance(output, tuple):
+        output = output[0]
+    return output[:, q_size:].t().contiguous()
+
