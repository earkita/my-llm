     return name
 
 
+def _remap_fp8_linear_scale_name(name: str) -> str:
+    """Map serialized FP8 inverse-scale names to CT linear parameters.
+
+    Expert loaders consume their checkpoint-native ``weight_scale_inv``
+    names directly. Compressed-tensors Linear methods instead register the
+    same dequantization scale as ``weight_scale``.
+    """
+
+    suffix = ".weight_scale_inv"
+    if name.endswith(suffix) and ".experts." not in name:
+        return f"{name[: -len(suffix)]}.weight_scale"
+    return name
+
+
