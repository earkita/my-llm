index 0000000..3c85feb
--- /dev/null
+++ b/tests/models/qwen4_exp/test_amd_low_latency_gemm.py
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+import torch
+from torch import nn
+
+from vllm.models.qwen4_exp.amd import low_latency_gemm
+from vllm.platforms import current_platform
+
+pytestmark = pytest.mark.skipif(
+    not current_platform.is_rocm(),
+    reason="AMD Qwen4Exp GEMM requires ROCm",
+)
+
+
+@pytest.mark.parametrize(
+    ("num_tokens", "block_m", "group_m"),
+    [(1, 16, 1), (16, 16, 1), (17, 64, 4), (2048, 64, 4)],
+)
+def test_rdna4_triton_config_is_complete(
+    num_tokens: int,
+    block_m: int,
+    group_m: int,
+) -> None:
+    config = low_latency_gemm._triton_gemm_config(num_tokens, 2560)
+
+    assert config["BLOCK_SIZE_M"] == block_m
+    assert config["GROUP_SIZE_M"] == group_m
+    assert config["BLOCK_SIZE_N"] == 64
+    assert config["BLOCK_SIZE_K"] == 32
+    assert config["NUM_KSPLIT"] == 1
+    assert config["SPLITK_BLOCK_SIZE"] == 2560
+
+
+def test_rdna4_triton_gemm_fake_preserves_batch_shape() -> None:
+    x = torch.empty(2, 3, 64)
+    weight = torch.empty(32, 64)
+
+    output = low_latency_gemm._qwen4_exp_rdna4_bf16_gemm_fake(x, weight)
+
+    assert output.shape == (2, 3, 32)
+    assert output.dtype == x.dtype
+
+
+def test_rdna4_triton_gemm_fails_closed_on_cpu() -> None:
+    x = torch.empty(3, 64, dtype=torch.bfloat16)
+    weight = torch.empty(32, 64, dtype=torch.bfloat16)
+
+    with pytest.raises(RuntimeError, match="refusing to fall back"):
+        low_latency_gemm._qwen4_exp_rdna4_bf16_gemm(x, weight)
+
+
+class _FakeMoERunner(nn.Module):
+    def __init__(self, fuse_gate: bool) -> None:
+        super().__init__()
+        self._fse_fuse_gate = fuse_gate
+
+
+def test_mtp_unfused_gate_layout_is_valid() -> None:
+    runner = _FakeMoERunner(fuse_gate=False)
+    module = nn.Module()
+    module.moe_layers = [runner]
+
+    count, routed = low_latency_gemm._route_mtp_fused_gate_runners(module)
+
+    assert count == 1
+    assert routed == 0
+    assert not hasattr(runner, "_qwen4_exp_rdna4_triton_bf16_gemm")
+
+
+def test_mtp_fused_gate_runner_is_marked() -> None:
+    runner = _FakeMoERunner(fuse_gate=True)
+    module = nn.Module()
+    module.moe_layers = [runner]
+
+    count, routed = low_latency_gemm._route_mtp_fused_gate_runners(module)
+
+    assert count == 1
+    assert routed == 1
+    assert runner._qwen4_exp_rdna4_triton_bf16_gemm is True
+
+
+def test_mtp_missing_moe_runners_fails_closed() -> None:
+    with pytest.raises(RuntimeError, match="no registered MoE runners"):
+        low_latency_gemm._route_mtp_fused_gate_runners(nn.Module())
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires an AMD GPU")
+def test_rdna4_triton_gemm_matches_torch_reference() -> None:
+    torch.manual_seed(1)
+    x = torch.randn(3, 2560, device="cuda", dtype=torch.bfloat16) * 0.05
+    weight = torch.randn(320, 2560, device="cuda", dtype=torch.bfloat16) * 0.05
+    expected = (x.float().cpu() @ weight.float().cpu().T).to(torch.bfloat16)
+
+    output = low_latency_gemm._qwen4_exp_rdna4_bf16_gemm(x, weight)
+
+    torch.testing.assert_close(output.cpu(), expected, rtol=0, atol=1.0e-3)
