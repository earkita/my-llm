-"""Qwen4Exp low-latency GEMM hook for AMD ROCm."""
+"""Qwen4Exp BF16 GEMM routing for AMD RDNA4."""
+
+import os
 
 import torch
 from torch import nn
 
+from vllm.model_executor.layers.linear import LinearBase, UnquantizedLinearMethod
+from vllm.model_executor.layers.vocab_parallel_embedding import (
+    ParallelLMHead,
+    UnquantizedEmbeddingMethod,
+)
+from vllm.platforms.rocm import on_rdna4
+from vllm.utils.torch_utils import direct_register_custom_op
+
+_RDNA4_TRITON_GEMM_ENV = "VLLM_QWEN4_EXP_RDNA4_TRITON_BF16_GEMM"
+
+
+def _triton_gemm_config(num_tokens: int, inner_size: int) -> dict[str, object]:
+    """Return a conservative, gfx1201-validated A16W16 configuration."""
+
+    if num_tokens <= 16:
+        block_m = 16
+        group_m = 1
+    else:
+        block_m = 64
+        group_m = 4
+    return {
+        "BLOCK_SIZE_M": block_m,
+        "BLOCK_SIZE_N": 64,
+        "BLOCK_SIZE_K": 32,
+        "GROUP_SIZE_M": group_m,
+        "NUM_KSPLIT": 1,
+        "SPLITK_BLOCK_SIZE": inner_size,
+        "cache_modifier": None,
+        "num_warps": 4,
+        "num_stages": 2,
+        "waves_per_eu": 2,
+        "matrix_instr_nonkdim": 16,
+        "kpack": 1,
+    }
+
+
+def _qwen4_exp_rdna4_bf16_gemm(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Run Qwen4Exp's unquantized BF16 GEMMs without rocBLAS/Tensile."""
+
+    if (
+        x.dtype != torch.bfloat16
+        or weight.dtype != torch.bfloat16
+        or weight.dim() != 2
+        or x.shape[-1] != weight.shape[1]
+        or not weight.is_contiguous()
+        or not x.is_cuda
+        or not weight.is_cuda
+        or x.device != weight.device
+        or (bias is not None and (bias.dtype != x.dtype or not bias.is_contiguous()))
+    ):
+        raise RuntimeError(
+            "RDNA4 Qwen4Exp Triton GEMM received unsupported operands; "
+            "refusing to fall back to rocBLAS/Tensile"
+        )
+
+    from aiter.ops.triton.gemm.basic.gemm_a16w16 import gemm_a16w16
+
+    output_shape = (*x.shape[:-1], weight.shape[0])
+    x_2d = x.reshape(-1, x.shape[-1]).contiguous()
+    output = gemm_a16w16(
+        x_2d,
+        weight,
+        bias,
+        dtype=x.dtype,
+        config=_triton_gemm_config(x_2d.shape[0], x_2d.shape[1]),
+        backend="triton",
+    )
+    return output.reshape(output_shape)
+
+
+def _qwen4_exp_rdna4_bf16_gemm_fake(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None = None,
+) -> torch.Tensor:
+    del bias
+    return x.new_empty((*x.shape[:-1], weight.shape[0]))
+
+
+direct_register_custom_op(
+    op_name="qwen4_exp_rdna4_bf16_gemm",
+    op_func=_qwen4_exp_rdna4_bf16_gemm,
+    fake_impl=_qwen4_exp_rdna4_bf16_gemm_fake,
+)
+
+
+class _Qwen4ExpRDNA4TritonApply:
+    def apply(
+        self,
+        layer: nn.Module,
+        x: torch.Tensor,
+        bias: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        return torch.ops.vllm.qwen4_exp_rdna4_bf16_gemm(x, layer.weight, bias)
+
+
+class Qwen4ExpRDNA4TritonLinearMethod(
+    _Qwen4ExpRDNA4TritonApply, UnquantizedLinearMethod
+):
+    pass
+
+
+class Qwen4ExpRDNA4TritonEmbeddingMethod(
+    _Qwen4ExpRDNA4TritonApply, UnquantizedEmbeddingMethod
+):
+    pass
+
+
+def _route_mtp_fused_gate_runners(module: nn.Module) -> tuple[int, int]:
+    """Mark MTP-owned MoE runners whose gate weights are actually fused."""
+
+    moe_runners = list(getattr(module, "moe_layers", ()))
+    if not moe_runners:
+        raise RuntimeError("RDNA4 Qwen4Exp MTP has no registered MoE runners")
+
+    routed_fused_gates = 0
+    for runner in moe_runners:
+        if not hasattr(runner, "_fse_fuse_gate"):
+            raise RuntimeError(
+                "RDNA4 Qwen4Exp MTP MoE runner has no fused-gate contract"
+            )
+        if runner._fse_fuse_gate:
+            runner._qwen4_exp_rdna4_triton_bf16_gemm = True
+            routed_fused_gates += 1
+
+    return len(moe_runners), routed_fused_gates
+

 def enable_qwen4_exp_low_latency_gemm(
     module: nn.Module,
     dtype: torch.dtype,
 ) -> None:
-    """Keep the standard vLLM linear methods on AMD ROCm."""
+    """Route only the MTP predictor's BF16 GEMMs through AITER Triton.
+
+    gfx1201 rocBLAS can select unsafe Tensile kernels for several MTP shapes.
+    The target model remains on its regular FP8/hipBLASLt paths; limiting this
+    hook to the draft model avoids changing its established prefill behavior.
+    """
+
+    if (
+        os.getenv(_RDNA4_TRITON_GEMM_ENV, "0") != "1"
+        or dtype != torch.bfloat16
+        or not on_rdna4()
+        or type(module).__name__ != "Qwen4ExpMTP"
+    ):
+        return
 
-    del module, dtype
+    routed_linears = 0
+    for child in module.modules():
+        is_linear = (
+            isinstance(child, LinearBase)
+            and type(child.quant_method) is UnquantizedLinearMethod
+        )
+        is_head = (
+            isinstance(child, ParallelLMHead)
+            and type(child.quant_method) is UnquantizedEmbeddingMethod
+        )
+        if is_linear:
+            child.quant_method = Qwen4ExpRDNA4TritonLinearMethod()
+            routed_linears += 1
+        elif is_head:
+            child.quant_method = Qwen4ExpRDNA4TritonEmbeddingMethod()
+            routed_linears += 1
+
+    # The model's EPLB interface keeps the exact MTP-owned MoE runners in a
+    # plain list. A runner only bypasses the LinearBase methods above when it
+    # has actually fused its routed and shared-expert gates. Zero fused gates
+    # is valid: in that layout both gate linears are already routed above.
+    moe_runners, routed_fused_gates = _route_mtp_fused_gate_runners(module)
+
+    if routed_linears == 0:
+        raise RuntimeError(
+            "RDNA4 Qwen4Exp MTP Triton routing was incomplete: "
+            f"linear/head={routed_linears}, moe_runners={moe_runners}, "
+            f"fused_gate={routed_fused_gates}"
+        )
