+def test_zero_retention_mamba_keeps_eagle_fallback_boundary():
+    """Mamba must retain the boundary where an incomplete EAGLE peek lands."""
+    block_size = 4
+    kv_cache_config = KVCacheConfig(
+        num_blocks=100,
+        kv_cache_tensors=[],
+        kv_cache_groups=[
+            KVCacheGroupSpec(
+                ["full"],
+                FullAttentionSpec(
+                    block_size=block_size,
+                    num_kv_heads=1,
+                    head_size=1,
+                    dtype=torch.float16,
+                ),
+            ),
+            KVCacheGroupSpec(
+                ["mamba"],
+                MambaSpec(
+                    block_size=block_size,
+                    shapes=(1, 1),
+                    dtypes=(torch.float32,),
+                    mamba_cache_mode="align",
+                ),
+            ),
+            KVCacheGroupSpec(
+                ["swa_eagle"],
+                SlidingWindowSpec(
+                    block_size=block_size,
+                    num_kv_heads=1,
+                    head_size=1,
+                    dtype=torch.float32,
+                    sliding_window=2 * block_size,
+                ),
+                is_eagle_group=True,
+            ),
+        ],
+    )
+    manager = make_kv_cache_manager(
+        kv_cache_config=kv_cache_config,
+        max_model_len=8192,
+        enable_caching=True,
+        hash_block_size=block_size,
+        retention_interval=0,
+        use_eagle=True,
+    )
+
+    # Three complete blocks plus a partial fourth. EAGLE cannot cache its peek
+    # block, so after the mandatory pop the reusable boundary is block 1 (8
+    # tokens), not the replay boundary at block 2 (12 tokens).
+    token_ids = [i for i in range(3) for _ in range(block_size)] + [3, 3]
+    req0 = make_request("owner", token_ids, block_size, sha256)
+    computed_blocks, num_computed, _ = manager.get_computed_blocks(req0)
+    assert num_computed == 0
+    assert manager.allocate_slots(req0, 2 * block_size, 0, computed_blocks) is not None
+
+    req0.num_computed_tokens = 2 * block_size
+    manager.new_step_starts()
+    assert manager.allocate_slots(req0, len(token_ids) - 2 * block_size) is not None
+
+    pool = manager.block_pool
+    assert pool.get_cached_block(req0.block_hashes[1], [1]) is not None
+    manager.free(req0)
+
+    replay = make_request("replay", token_ids, block_size, sha256)
+    computed_blocks, num_computed, _ = manager.get_computed_blocks(replay)
+    assert num_computed == 2 * block_size
+    assert [len(group) for group in computed_blocks.blocks] == [2, 2, 2]
+
