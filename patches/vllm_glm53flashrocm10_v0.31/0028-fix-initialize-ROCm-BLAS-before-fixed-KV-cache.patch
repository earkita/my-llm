 import pytest
 
@@ -155,6 +155,83 @@ def test_profiling_fallback_declines_off_rocm(rocm):
     assert maybe_rocm_profiling_fallback(result) is None
 
 
+def test_initialize_from_config_creates_rocm_blas_handle_before_kv_cache(
+    monkeypatch: pytest.MonkeyPatch,
+):
+    events: list[str] = []
+    tensor = MagicMock()
+    tensor.T = tensor
+    tensor.transpose.return_value = tensor
+    worker = SimpleNamespace(
+        cache_config=SimpleNamespace(num_gpu_blocks=None),
+        model_config=SimpleNamespace(enable_return_routed_experts=False),
+        model_runner=SimpleNamespace(
+            initialize_kv_cache=lambda *args, **kwargs: events.append("kv_cache")
+        ),
+        vllm_config=SimpleNamespace(
+            kv_transfer_config=SimpleNamespace(kv_connector="OffloadingConnector")
+        ),
+        _maybe_get_memory_pool_context=lambda tag: nullcontext(),
+    )
+    config = SimpleNamespace(
+        num_blocks=1,
+        kv_cache_layout=None,
+        needs_kv_cache_zeroing=False,
+    )
+    monkeypatch.setattr(
+        gpu_worker, "current_platform", SimpleNamespace(is_rocm=lambda: True)
+    )
+    monkeypatch.setattr(
+        gpu_worker.torch.cuda,
+        "current_blas_handle",
+        lambda: events.append("blas_handle"),
+    )
+    monkeypatch.setattr(gpu_worker.torch, "empty", lambda *args, **kwargs: tensor)
+    monkeypatch.setattr(
+        gpu_worker.torch,
+        "bmm",
+        lambda *args, **kwargs: events.append("bmm"),
+    )
+    monkeypatch.setattr(
+        gpu_worker.torch.nn.functional,
+        "linear",
+        lambda *args, **kwargs: events.append("linear"),
+    )
+    monkeypatch.setattr(
+        gpu_worker.torch,
+        "mm",
+        lambda *args, **kwargs: events.append("router"),
+    )
+    monkeypatch.setattr(
+        gpu_worker.torch.cuda,
+        "synchronize",
+        lambda: events.append("synchronize"),
+    )
+    monkeypatch.setattr(
+        gpu_worker.torch.cuda,
+        "empty_cache",
+        lambda: events.append("empty_cache"),
+    )
+    monkeypatch.setattr(
+        gpu_worker,
+        "ensure_kv_transfer_initialized",
+        lambda *args: events.append("kv_transfer"),
+    )
+
+    gpu_worker.Worker.initialize_from_config(worker, config)
+
+    assert events == [
+        "blas_handle",
+        "bmm",
+        "linear",
+        "router",
+        "synchronize",
+        "empty_cache",
+        "kv_transfer",
+        "kv_cache",
+    ]
+
+
 class _OrderedHandle:
     """Send handle that logs when it is waited."""
 
diff --git a/vllm/v1/worker/gpu_worker.py b/vllm/v1/worker/gpu_worker.py
index e832e4a..1c1b1b2 100644
--- a/vllm/v1/worker/gpu_worker.py
+++ b/vllm/v1/worker/gpu_worker.py
@@ -719,6 +719,44 @@ class Worker(WorkerBase):
     def initialize_from_config(self, kv_cache_config: KVCacheConfig) -> None:
         """Allocate GPU KV cache with the specified kv_cache_config."""
 
+        # ROCm loads hipBLASLt code objects lazily for each GEMM family. The
+        # fixed-address KV allocation used by OffloadingConnector can consume
+        # the final device-memory region before model warmup reaches these BF16
+        # operations. Exercise the shapes used by GLM decode while memory is
+        # available, then release the temporary tensors before allocating KV.
+        kv_transfer_config = self.vllm_config.kv_transfer_config
+        if (
+            current_platform.is_rocm()
+            and kv_transfer_config is not None
+            and kv_transfer_config.kv_connector == "OffloadingConnector"
+        ):
+            _ = torch.cuda.current_blas_handle()
+            dtype = torch.bfloat16
+            bmm_input = torch.empty((16, 6, 512), device="cuda", dtype=dtype)
+            bmm_weight = torch.empty((16, 512, 256), device="cuda", dtype=dtype)
+            bmm_output = torch.empty((6, 16, 256), device="cuda", dtype=dtype)
+            torch.bmm(bmm_input, bmm_weight, out=bmm_output.transpose(0, 1))
+            linear_input = torch.empty((6, 2048), device="cuda", dtype=dtype)
+            linear_weight = torch.empty((4096, 2048), device="cuda", dtype=dtype)
+            torch.nn.functional.linear(linear_input, linear_weight)
+            router_input = torch.empty((6, 4096), device="cuda", dtype=dtype)
+            router_weight = torch.empty((288, 4096), device="cuda", dtype=dtype)
+            torch.mm(router_input, router_weight.T, out_dtype=torch.float32)
+            torch.cuda.synchronize()
+            del (
+                bmm_input,
+                bmm_weight,
+                bmm_output,
+                linear_input,
+                linear_weight,
+                router_input,
+                router_weight,
+            )
+            torch.cuda.empty_cache()
+            logger.info_once(
+                "Preloaded ROCm BF16 BLAS kernels before KV cache allocation."
+            )
+
         # Update local config with adjusted num blocks after profiling,
         # so that it's available to the warmup stage.
         self.cache_config.num_gpu_blocks = kv_cache_config.num_blocks
