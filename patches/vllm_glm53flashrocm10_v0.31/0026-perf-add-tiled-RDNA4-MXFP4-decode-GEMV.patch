diff --git a/benchmarks/kernels/benchmark_rocm_mxfp4_gemv.py b/benchmarks/kernels/benchmark_rocm_mxfp4_gemv.py
new file mode 100644
index 0000000000..5670c46f39
--- /dev/null
+++ b/benchmarks/kernels/benchmark_rocm_mxfp4_gemv.py
@@ -0,0 +1,174 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Compare scalar and output-tiled packed MXFP4 GEMV on ROCm.
+
+The default shapes mirror one TP8 GLM-5.3-Flash MoE shard during DFlash K4
+verification: five input rows become forty top-k routes for the up projection,
+followed by forty independent down-projection rows.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+import torch
+
+from vllm.model_executor.kernels.linear.mxfp4.rocm_gemv import (
+    ROCM_MXFP4_GEMV_BLOCK_N_CHOICES,
+    rocm_mxfp4_row_gemv,
+)
+from vllm.triton_utils import triton
+
+
+def _case(
+    *,
+    name: str,
+    rows: int,
+    routes_per_input: int,
+    output_size: int,
+    input_size: int,
+    experts: int,
+) -> dict[str, Any]:
+    generator = torch.Generator(device="cuda").manual_seed(20260909)
+    x = torch.randn(
+        (rows, input_size),
+        generator=generator,
+        device="cuda",
+        dtype=torch.bfloat16,
+    )
+    weight = torch.randint(
+        0,
+        256,
+        (experts, output_size, input_size // 2),
+        generator=generator,
+        device="cuda",
+        dtype=torch.uint8,
+    )
+    weight_scale = torch.randint(
+        118,
+        130,
+        (experts, output_size, input_size // 32),
+        generator=generator,
+        device="cuda",
+        dtype=torch.uint8,
+    )
+    routes = rows * routes_per_input
+    expert_ids = torch.arange(routes, device="cuda", dtype=torch.int32) % experts
+    route_weights = torch.rand(
+        routes, generator=generator, device="cuda", dtype=torch.float32
+    )
+
+    outputs: dict[int, torch.Tensor] = {}
+    timings: dict[str, dict[str, float]] = {}
+    for block_n in ROCM_MXFP4_GEMV_BLOCK_N_CHOICES:
+        output = torch.empty((routes, output_size), device="cuda", dtype=torch.bfloat16)
+
+        def run(output: torch.Tensor = output, block_n: int = block_n) -> None:
+            rocm_mxfp4_row_gemv(
+                x,
+                weight,
+                weight_scale,
+                expert_ids=expert_ids,
+                route_weights=route_weights,
+                routes_per_input=routes_per_input,
+                out=output,
+                block_n=block_n,
+            )
+
+        run()
+        torch.cuda.synchronize()
+        outputs[block_n] = output.clone()
+        median, p20, p80 = triton.testing.do_bench(
+            run,
+            warmup=100,
+            rep=500,
+            quantiles=[0.5, 0.2, 0.8],
+        )
+        timings[str(block_n)] = {
+            "median_ms": float(median),
+            "p20_ms": float(p20),
+            "p80_ms": float(p80),
+        }
+
+    reference = outputs[0]
+    correctness = {}
+    baseline_ms = timings["0"]["median_ms"]
+    for block_n, output in outputs.items():
+        diff = (output.float() - reference.float()).abs()
+        correctness[str(block_n)] = {
+            "max_abs_diff": float(diff.max().item()),
+            "mean_abs_diff": float(diff.mean().item()),
+            "close": bool(torch.allclose(output, reference, atol=0.125, rtol=0.04)),
+        }
+        timings[str(block_n)]["speedup_vs_scalar"] = (
+            baseline_ms / timings[str(block_n)]["median_ms"]
+        )
+
+    return {
+        "name": name,
+        "shape": {
+            "rows": rows,
+            "routes": routes,
+            "routes_per_input": routes_per_input,
+            "experts": experts,
+            "output_size": output_size,
+            "input_size": input_size,
+        },
+        "timings": timings,
+        "correctness": correctness,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    if not torch.version.hip:
+        parser.error("this benchmark requires ROCm")
+
+    payload = {
+        "schema_version": 1,
+        "generated_at": datetime.now().astimezone().isoformat(),
+        "device": torch.cuda.get_device_name(0),
+        "gfx_arch": torch.cuda.get_device_properties(0).gcnArchName,
+        "cases": [
+            _case(
+                name="glm53_tp8_moe_up_k4",
+                rows=5,
+                routes_per_input=8,
+                output_size=512,
+                input_size=4096,
+                experts=8,
+            ),
+            _case(
+                name="glm53_tp8_moe_down_k4",
+                rows=40,
+                routes_per_input=1,
+                output_size=4096,
+                input_size=256,
+                experts=8,
+            ),
+        ],
+    }
+    encoded = json.dumps(payload, indent=2) + "\n"
+    if args.output:
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(encoded, encoding="utf-8")
+    print(encoded, end="")
+    return (
+        0
+        if all(
+            result["close"]
+            for case in payload["cases"]
+            for result in case["correctness"].values()
+        )
+        else 1
+    )
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
