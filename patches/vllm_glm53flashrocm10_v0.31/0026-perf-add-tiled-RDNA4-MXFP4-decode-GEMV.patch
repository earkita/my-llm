+@triton.jit
+def _rocm_mxfp4_row_gemv_tiled_kernel(
+    x_ptr,
+    weight_ptr,
+    weight_scale_ptr,
+    expert_ids_ptr,
+    route_weights_ptr,
+    bias_ptr,
+    out_ptr,
+    K: tl.constexpr,
+    N: tl.constexpr,
+    num_experts,
+    routes_per_input: tl.constexpr,
+    stride_xm,
+    stride_xk,
+    stride_we,
+    stride_wn,
+    stride_wk,
+    stride_wse,
+    stride_wsn,
+    stride_wsk,
+    stride_be,
+    stride_bn,
+    stride_om,
+    stride_on,
+    HAS_EXPERT_IDS: tl.constexpr,
+    HAS_ROUTE_WEIGHTS: tl.constexpr,
+    HAS_BIAS: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    BLOCK_PACKED_K: tl.constexpr,
+):
+    """Compute several output columns while sharing each activation load.
+
+    Unlike the scalar-output kernel, this kernel walks packed weight bytes
+    directly.  Each byte supplies two E2M1 values, so it also avoids loading
+    the same packed byte once for the low nibble and again for the high nibble.
+    """
+    route = tl.program_id(0).to(tl.int64)
+    output_cols = tl.program_id(1).to(tl.int64) * BLOCK_N + tl.arange(0, BLOCK_N)
+    valid_output = output_cols < N
+
+    expert = tl.load(expert_ids_ptr + route).to(tl.int64) if HAS_EXPERT_IDS else 0
+    valid_expert = (expert >= 0) & (expert < num_experts)
+    safe_expert = tl.maximum(expert, 0)
+    input_row = route // routes_per_input
+
+    packed_offsets = tl.arange(0, BLOCK_PACKED_K)
+    acc = tl.zeros((BLOCK_N,), dtype=tl.float32)
+    # Keep these layout constants literal: Triton rejects ordinary Python
+    # globals referenced from a JIT kernel, even when their values are fixed.
+    for packed_start in range(0, K // 2, BLOCK_PACKED_K):
+        packed_k = packed_start + packed_offsets
+        valid_packed_k = packed_k < K // 2
+        weight_mask = valid_expert & valid_output[:, None] & valid_packed_k[None, :]
+        packed = tl.load(
+            weight_ptr
+            + safe_expert * stride_we
+            + output_cols[:, None] * stride_wn
+            + packed_k[None, :] * stride_wk,
+            mask=weight_mask,
+            other=0,
+        ).to(tl.int32)
+        scale = tl.load(
+            weight_scale_ptr
+            + safe_expert * stride_wse
+            + output_cols[:, None] * stride_wsn
+            + (packed_k[None, :] // 16) * stride_wsk,
+            mask=weight_mask,
+            other=0,
+        )
+        block_scale = _e8m0_to_f32(scale)
+
+        even_k = packed_k * 2
+        odd_k = even_k + 1
+        x_even = tl.load(
+            x_ptr + input_row * stride_xm + even_k * stride_xk,
+            mask=valid_expert & valid_packed_k,
+            other=0.0,
+        ).to(tl.float32)
+        x_odd = tl.load(
+            x_ptr + input_row * stride_xm + odd_k * stride_xk,
+            mask=valid_expert & valid_packed_k,
+            other=0.0,
+        ).to(tl.float32)
+        low = _e2m1_to_f32(packed & 0xF)
+        high = _e2m1_to_f32((packed >> 4) & 0xF)
+        products = (x_even[None, :] * low + x_odd[None, :] * high) * block_scale
+        acc += tl.sum(products, axis=1)
+
+    if HAS_BIAS:
+        acc += tl.load(
+            bias_ptr + safe_expert * stride_be + output_cols * stride_bn,
+            mask=valid_expert & valid_output,
+            other=0.0,
+        ).to(tl.float32)
+    if HAS_ROUTE_WEIGHTS:
+        acc *= tl.load(route_weights_ptr + route).to(tl.float32)
+    acc = tl.where(valid_expert, acc, 0.0)
+    tl.store(
+        out_ptr + route * stride_om + output_cols * stride_on,
+        acc,
+        mask=valid_output,
+    )
+
