+
+
+@pytest.mark.parametrize("async_scheduling", [True, False])
+def test_retention_zero_keeps_short_eagle_prefix_fallback(
+    request_runner, async_scheduling: bool
+):
+    """A partial EAGLE tail must not prune its short prefix fallback.
+
+    The 14-token prompt has three complete 4-token blocks and a partial
+    fourth block. EAGLE needs a three-block lookup window for SW=8. Its replay
+    boundary is shifted toward the unavailable fourth block, so retaining only
+    that boundary tail would drop block 0 and make the lookup fallback miss.
+    """
+    block_size = 4
+    groups = [
+        KVCacheGroupSpec(
+            ["target"],
+            FullAttentionSpec(
+                block_size=block_size,
+                num_kv_heads=1,
+                head_size=1,
+                dtype=torch.float32,
+            ),
+        ),
+        KVCacheGroupSpec(
+            ["draft"],
+            SlidingWindowSpec(
+                block_size=block_size,
+                num_kv_heads=1,
+                head_size=1,
+                dtype=torch.float32,
+                sliding_window=8,
+            ),
+            is_eagle_group=True,
+        ),
+    ]
+    runner = request_runner(
+        block_size=block_size,
+        num_gpu_blocks=100,
+        async_scheduling=async_scheduling,
+        kv_cache_groups=groups,
+        retention_interval=0,
+    )
+    runner.new_request(token_ids=[0] * 14)
+    runner.manager.prepare_store.side_effect = lambda keys, req_context: (
+        generate_store_output(keys)
+    )
+
+    runner.run(
+        decoded_tokens=[EOS_TOKEN_ID],
+        expected_stored=(
+            (0, 0),
+            (0, 1),
+            (0, 2),
+            (1, 0),
+            (1, 1),
+            (1, 2),
+        ),
+    )
