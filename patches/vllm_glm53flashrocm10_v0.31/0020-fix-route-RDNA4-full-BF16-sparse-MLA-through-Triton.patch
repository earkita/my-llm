+    )
     return (
-        (not fp8_cache or (standard_fp8_cache and fp8_triton_supported))
-        and head_size == kv_lora_rank
+        supported_cache
+        and supported_dims
         and (num_prefills > 0 or num_decodes > 0)
     )
 
