+@pytest.mark.skipif(not current_platform.is_rocm(), reason="ROCm required")
+def test_full_glm_sparse_prefill_matches_torch_reference():
+    torch.manual_seed(7)
+    device = torch.device("cuda")
+    num_queries, num_heads = 2, 16
+    qk_dim, value_dim, num_kv, topk = 576, 512, 257, 128
+    q = torch.randn(
+        num_queries, num_heads, qk_dim, device=device, dtype=torch.bfloat16
+    )
+    kv = torch.randn(num_kv, 1, qk_dim, device=device, dtype=torch.bfloat16)
+    rows = [
+        (torch.arange(topk, device=device, dtype=torch.int32) * (row + 1) + 3)
+        % num_kv
+        for row in range(num_queries)
+    ]
+    indices = torch.cat(rows)
+    indptr = torch.arange(
+        0,
+        (num_queries + 1) * topk,
+        topk,
+        device=device,
+        dtype=torch.int32,
+    )
+    output = torch.empty(
+        num_queries, num_heads, value_dim, device=device, dtype=torch.bfloat16
+    )
+    scale = qk_dim**-0.5
+    rocm_sparse_attn_prefill(
+        q=q,
+        kv=kv,
+        indices=None,
+        topk_length=None,
+        scale=scale,
+        head_dim=qk_dim,
+        nope_head_dim=value_dim,
+        rope_head_dim=qk_dim - value_dim,
+        attn_sink=None,
+        output=output,
+        ragged_indices=indices,
+        ragged_indptr=indptr,
+    )
+
+    reference = []
+    for row in range(num_queries):
+        selected = kv[rows[row].long(), 0]
+        scores = torch.einsum("hd,kd->hk", q[row].float(), selected.float())
+        probs = torch.softmax(scores * scale, dim=-1)
+        reference.append(
+            torch.einsum("hk,kv->hv", probs, selected[:, :value_dim].float())
+        )
+    torch.testing.assert_close(
+        output.float(), torch.stack(reference), rtol=0.03, atol=0.03
+    )
