+def test_get_kv_cache_config_glm5_with_aligned_dflash_pages():
+    """DFlash pages alias MLA slots only at the same global block id.
+
+    GLM's layer-outer allocation requires every overlaid group to use the
+    target MLA page as its physical block stride. Scale the draft's logical
+    block size by an integer ratio instead of giving it an independent stride,
+    which would make different global block ids overlap live target pages.
+    """
+    model_config = ModelConfig(max_model_len=8192)
+    vllm_config = VllmConfig(model_config=model_config)
+    vllm_config.speculative_config = SimpleNamespace(
+        method="dflash", parallel_drafting=True, use_dflash=lambda: True
+    )
+
+    target_spec = _glm5_like_kv_cache_spec_with_tail()
+    mla_page = target_spec["layers.3.attn"].page_size_bytes
+    draft_names = [f"dflash_head.model.layers.{i}.self_attn.attn" for i in range(5)]
+    for name in draft_names:
+        target_spec[name] = SlidingWindowSpec(
+            block_size=1024,
+            num_kv_heads=1,
+            head_size=144,
+            dtype=torch.bfloat16,
+            sliding_window=8192,
+        )
+    original_draft_page = target_spec[draft_names[0]].page_size_bytes
+    assert mla_page == 2 * original_draft_page
+
+    target_only_spec = {
+        name: spec for name, spec in target_spec.items() if name not in draft_names
+    }
+    target_only_groups = kv_cache_utils.get_kv_cache_groups(
+        VllmConfig(model_config=ModelConfig(max_model_len=8192)), target_only_spec
+    )
+    groups = kv_cache_utils.get_kv_cache_groups(vllm_config, target_spec)
+    layout = kv_cache_utils._glm5_next_tensor_layout(groups)
+    assert layout is not None
+    draft_group = layout[8]
+    assert draft_group is not None
+    assert draft_group.is_eagle_group
+    assert draft_group.layer_names == draft_names
+
+    draft_inner = cast(
+        UniformTypeKVCacheSpecs, draft_group.kv_cache_spec
+    ).kv_cache_specs
+    assert all(spec.block_size == 2048 for spec in draft_inner.values())
+    assert all(spec.page_size_bytes == mla_page for spec in draft_inner.values())
+
+    bytes_per_block = kv_cache_utils._pool_bytes_per_block(groups)
+    assert bytes_per_block == kv_cache_utils._pool_bytes_per_block(target_only_groups)
+    config = kv_cache_utils.get_kv_cache_config_from_groups(
+        vllm_config, groups, bytes_per_block * 100
+    )
+    assert config.num_blocks == 100
+    tensors = _tensor_by_layer(config)
+    mla_names = [f"layers.{i}.attn" for i in range(3, 45, 4)]
+    for index, draft_name in enumerate(draft_names):
+        draft_tensor = tensors[draft_name]
+        target_tensor = tensors[mla_names[index]]
+        assert draft_tensor.offset == target_tensor.offset
+        assert draft_tensor.block_stride == target_tensor.block_stride == mla_page
+        assert draft_tensor.layer_stride == target_tensor.layer_stride
+        # Distinct global block ids must name disjoint physical pages.
+        for target_block in range(3):
+            for draft_block in range(3):
+                if target_block == draft_block:
+                    continue
+                target_begin = target_tensor.offset + target_block * mla_page
+                draft_begin = draft_tensor.offset + draft_block * mla_page
+                assert target_begin + mla_page <= draft_begin or (
+                    draft_begin + mla_page <= target_begin
+                )
+
+    draft_blocks = (
+        draft_group.kv_cache_spec.max_memory_usage_bytes(vllm_config)
+        // draft_group.kv_cache_spec.page_size_bytes
+    )
+    assert kv_cache_utils._max_memory_usage_bytes_from_groups(
+        vllm_config, groups
+    ) == kv_cache_utils._max_memory_usage_bytes_from_groups(
+        vllm_config, target_only_groups
+    ) + draft_blocks * bytes_per_block
+    scheduler_block_size, _ = kv_cache_utils.resolve_kv_cache_block_sizes(
+        config, vllm_config
+    )
+    assert scheduler_block_size == 2048
+
+
