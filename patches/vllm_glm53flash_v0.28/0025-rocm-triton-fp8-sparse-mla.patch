+@torch.inference_mode()
+def test_sparse_attn_prefill_ragged_kernel_fp8_kv_scale() -> None:
+    from vllm import _custom_ops as ops
+    from vllm.v1.attention.ops.rocm_aiter_mla_sparse import (
+        _rocm_sparse_attn_prefill_ragged_triton,
+    )
+
+    device = torch.device("cuda")
+    torch.manual_seed(7)
+    head_dim = 512
+    q = torch.randn(3, 3, head_dim, dtype=torch.bfloat16, device=device) * 0.125
+    kv_source = (
+        torch.randn(5, head_dim, dtype=torch.bfloat16, device=device) * 0.125
+    )
+    kv_scale = torch.tensor(0.03125, dtype=torch.float32, device=device)
+    kv_storage = torch.empty_like(kv_source, dtype=torch.uint8)
+    ops.convert_fp8(kv_storage, kv_source, kv_scale.item(), kv_dtype="fp8")
+    kv = kv_storage.view(current_platform.fp8_dtype())
+
+    dequantized_kv = torch.empty_like(kv_source)
+    ops.convert_fp8(
+        dequantized_kv, kv_storage, kv_scale.item(), kv_dtype="fp8"
+    )
+    indices = torch.tensor([0, 2, 1, 3, 4], dtype=torch.int32, device=device)
+    indptr = torch.tensor([0, 2, 5, 5], dtype=torch.int32, device=device)
+    scale = head_dim**-0.5
+
+    actual = _rocm_sparse_attn_prefill_ragged_triton(
+        q=q,
+        kv=kv,
+        indices=indices,
+        indptr=indptr,
+        scale=scale,
+        attn_sink=None,
+        nope_head_dim=head_dim,
+        rope_head_dim=0,
+        kv_scale=kv_scale,
+    )
+    expected = _ref_sparse_prefill_ragged(
+        q, dequantized_kv, [[0, 2], [1, 3, 4], []], scale, None
+    )
+
+    torch.testing.assert_close(actual, expected, atol=3e-2, rtol=3e-2)
+
