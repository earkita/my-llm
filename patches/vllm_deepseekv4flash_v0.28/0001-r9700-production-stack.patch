@@ -0,0 +1,316 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Transactional suffix storage for DSpark late prefill materialization."""
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from enum import IntEnum
+
+import numpy as np
+import torch
+
+
+class DSparkSuffixState(IntEnum):
+    EMPTY = 0
+    BUFFERING = 1
+    MATERIALIZED = 2
+    INVALID = 3
+
+
+@dataclass(frozen=True)
+class DSparkRequestOwner:
+    req_idx: int
+    generation: int
+    req_id: str
+
+
+class DSparkAuxSuffixRing:
+    """Keep the last ``window`` raw auxiliary states for each live request.
+
+    GPU data is keyed by a CPU owner tuple. Slot generations make a batch
+    snapshot reject stale async work even when both the request id and slot are
+    reused. Absolute-position tags make ring wrap and missing-prefix errors
+    fail closed before any draft KV is written.
+    """
+
+    def __init__(
+        self,
+        max_num_reqs: int,
+        num_aux_layers: int,
+        window: int,
+        hidden_size: int,
+        dtype: torch.dtype,
+        device: torch.device,
+    ) -> None:
+        if min(max_num_reqs, num_aux_layers, window, hidden_size) <= 0:
+            raise ValueError("DSpark suffix-ring dimensions must be positive")
+        self.max_num_reqs = max_num_reqs
+        self.num_aux_layers = num_aux_layers
+        self.window = window
+        self.hidden_size = hidden_size
+        self.dtype = dtype
+        self.device = device
+
+        self.data = torch.empty(
+            max_num_reqs,
+            num_aux_layers,
+            window,
+            hidden_size,
+            dtype=dtype,
+            device=device,
+        )
+        self.tags = np.full((max_num_reqs, window), -1, dtype=np.int64)
+        self.generations = np.zeros(max_num_reqs, dtype=np.int64)
+        self.next_positions = np.full(max_num_reqs, -1, dtype=np.int64)
+        self.states = np.full(
+            max_num_reqs, DSparkSuffixState.EMPTY, dtype=np.uint8
+        )
+        self.owners: list[DSparkRequestOwner | None] = [None] * max_num_reqs
+
+        self.tokens_seen = 0
+        self.tokens_retained = 0
+        self.materializations = 0
+        self.cache_resumes = 0
+        self.resets = 0
+        self.wraps = 0
+
+    def _check_req_idx(self, req_idx: int) -> None:
+        if not 0 <= req_idx < self.max_num_reqs:
+            raise RuntimeError(f"DSpark request slot out of range: {req_idx}")
+
+    def bind(
+        self, req_id: str, req_idx: int, num_computed_tokens: int
+    ) -> DSparkRequestOwner:
+        self._check_req_idx(req_idx)
+        if self.owners[req_idx] is not None:
+            raise RuntimeError(
+                f"DSpark request slot {req_idx} was rebound without release"
+            )
+        self.generations[req_idx] += 1
+        owner = DSparkRequestOwner(
+            req_idx=req_idx,
+            generation=int(self.generations[req_idx]),
+            req_id=req_id,
+        )
+        self.owners[req_idx] = owner
+        self.tags[req_idx].fill(-1)
+        self.next_positions[req_idx] = num_computed_tokens
+        if num_computed_tokens < 0:
+            raise RuntimeError("DSpark computed-token count cannot be negative")
+        # The scheduler's local prefix hit is the common hit across every KV
+        # group, including the DSpark draft groups. Their sliding-window suffix
+        # is therefore already materialized and can accept the uncached tail.
+        # External KV remains rejected by the late-prefill configuration.
+        self.states[req_idx] = (
+            DSparkSuffixState.MATERIALIZED
+            if num_computed_tokens > 0
+            else DSparkSuffixState.EMPTY
+        )
+        if num_computed_tokens > 0:
+            self.cache_resumes += 1
+        return owner
+
+    def release(self, req_id: str, req_idx: int) -> None:
+        self._check_req_idx(req_idx)
+        owner = self.owners[req_idx]
+        if owner is None:
+            return
+        if owner.req_id != req_id:
+            raise RuntimeError(
+                "DSpark request-slot owner mismatch during release: "
+                f"slot={req_idx} expected={owner.req_id!r} got={req_id!r}"
+            )
+        self.owners[req_idx] = None
+        self.tags[req_idx].fill(-1)
+        self.next_positions[req_idx] = -1
+        self.states[req_idx] = DSparkSuffixState.EMPTY
+        self.resets += 1
+
+    def reset_all(self) -> None:
+        self.owners[:] = [None] * self.max_num_reqs
+        self.tags.fill(-1)
+        self.next_positions.fill(-1)
+        self.states.fill(DSparkSuffixState.EMPTY)
+        self.resets += 1
+
+    def snapshot_generations(
+        self, req_ids: Sequence[str], idx_mapping_np: np.ndarray
+    ) -> np.ndarray:
+        if len(req_ids) != len(idx_mapping_np):
+            raise RuntimeError("DSpark request snapshot has inconsistent lengths")
+        result = np.empty(len(req_ids), dtype=np.int64)
+        for row, (req_id, raw_idx) in enumerate(zip(req_ids, idx_mapping_np)):
+            req_idx = int(raw_idx)
+            owner = self._require_current(req_id, req_idx)
+            result[row] = owner.generation
+        return result
+
+    def owner_from_snapshot(
+        self, req_id: str, req_idx: int, generation: int
+    ) -> DSparkRequestOwner:
+        owner = DSparkRequestOwner(req_idx, generation, req_id)
+        self._validate_owner(owner)
