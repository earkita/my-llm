+# SPDX-License-Identifier: MIT
+
+import pytest
+import torch
+
+from aiter.ops.triton.utils._triton import arch_info
+
+
+def _reference(q, kv, indices, indptr, scale):
+    rows = []
+    for row in range(q.shape[0]):
+        selected = kv[indices[indptr[row] : indptr[row + 1]].long()].float()
+        scores = torch.einsum("hd,td->ht", q[row].float(), selected) * scale
+        rows.append(torch.einsum("ht,td->hd", scores.softmax(-1), selected))
+    return torch.stack(rows)
+
+
+@pytest.mark.parametrize("fp8_kv", [False, True])
+@pytest.mark.parametrize("topk", [17, 256, 2048])
+def test_sparse_mla_rdna4_rope_free(fp8_kv, topk):
+    if arch_info.get_arch() != "gfx1201":
+        pytest.skip("RDNA4 sparse MLA test requires gfx1201")
+
+    from aiter.ops.triton.attention.sparse_mla import sparse_mla_fwd
+
+    torch.manual_seed(7)
+    c, h, d, pool = 2, 12, 512, 4096
+    scale = d**-0.5
+    q = torch.randn(c, h, d, dtype=torch.bfloat16, device="cuda") * 0.125
+    truth = torch.randn(pool, d, dtype=torch.bfloat16, device="cuda") * 0.125
+    indices = torch.stack(
+        [torch.randperm(pool, device="cuda")[:topk] for _ in range(c)]
+    ).to(torch.int32)
+    flat_indices = indices.flatten()
+    indptr = torch.arange(0, (c + 1) * topk, topk, dtype=torch.int32, device="cuda")
+
+    if fp8_kv:
+        kv_scale = (truth.float().abs().amax() / 448.0).clamp_min(1e-30).reshape(1)
+        kv = (truth.float() / kv_scale).clamp(-448, 448).to(torch.float8_e4m3fn)
+        ref_kv = kv.float() * kv_scale
+    else:
+        kv_scale = None
+        kv = truth
+        ref_kv = truth.float()
+
+    out, _ = sparse_mla_fwd(
+        q,
+        kv,
+        indptr,
+        flat_indices,
+        scale,
+        kv_scale=kv_scale,
+        qk_rope_head_dim=0,
+    )
+    ref = _reference(q, ref_kv, flat_indices, indptr, scale)
+    rel = (out.float() - ref).abs().max() / ref.abs().max().clamp_min(1e-6)
+    assert rel.item() < (0.035 if fp8_kv else 0.02)
