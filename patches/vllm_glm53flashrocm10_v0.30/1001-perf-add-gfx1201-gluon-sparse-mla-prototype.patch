diff --git a/aiter/ops/triton/attention/sparse_mla_rdna4.py b/aiter/ops/triton/attention/sparse_mla_rdna4.py
new file mode 100644
index 0000000..616b0d7
--- /dev/null
+++ b/aiter/ops/triton/attention/sparse_mla_rdna4.py
@@ -0,0 +1,188 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2024-2026, Advanced Micro Devices, Inc. All rights reserved.
+
+"""Rope-free sparse MLA launcher for gfx1201 Gluon/WMMA experiments."""
+
+import math
+
+import torch
+import triton
+
+from aiter.ops.triton._gluon_kernels.gfx1201.attention.sparse_mla import (
+    _sparse_mla_gfx1201,
+    _sparse_mla_reduce_gfx1201,
+)
+
+
+_FP8_DTYPES = (torch.float8_e4m3fn, torch.float8_e4m3fnuz)
+
+
+def _as_i32_1d(x: torch.Tensor) -> torch.Tensor:
+    if x.dtype == torch.int32 and x.ndim == 1 and x.is_contiguous():
+        return x
+    return x.to(torch.int32).contiguous()
+
+
+def sparse_mla_fwd_rdna4(
+    q: torch.Tensor,
+    kv_buffer: torch.Tensor,
+    kv_indptr: torch.Tensor,
+    kv_indices: torch.Tensor,
+    softmax_scale: float,
+    kv_scale: torch.Tensor | None = None,
+    kv_lora_rank: int = 512,
+    qk_rope_head_dim: int = 0,
+    kv_splits: int | None = None,
+    skip_reduce: bool = False,
+    has_invalid: bool = False,
+    dot_precision: str = "bf16",
+    q_scale: torch.Tensor | None = None,
+    out: torch.Tensor | None = None,
+    return_lse: bool = False,
+) -> tuple[torch.Tensor, None]:
+    """Run the first gfx1201 sparse-MLA kernel for GLM-5.3-Flash.
+
+    Scope is deliberately narrow: rope-free, BF16 query and BF16 WMMA dots,
+    with either BF16 KV or OCP/FNUZ FP8 KV plus a scalar cache scale.
+    """
+    if qk_rope_head_dim != 0:
+        raise ValueError("gfx1201 sparse MLA currently supports rope-free GLM-5.3 only")
+    if skip_reduce or return_lse:
+        raise ValueError("gfx1201 sparse MLA does not expose partials or LSE yet")
+    if dot_precision != "bf16" or q_scale is not None:
+        raise ValueError("gfx1201 sparse MLA currently uses BF16 WMMA dots")
+    if q.ndim != 3 or q.dtype != torch.bfloat16:
+        raise ValueError(f"q must be [C,H,D] BF16, got {tuple(q.shape)} {q.dtype}")
+    if q.shape[2] != kv_lora_rank or kv_lora_rank != 512:
+        raise ValueError("gfx1201 sparse MLA currently requires D=kv_lora_rank=512")
+
+    if kv_buffer.ndim == 4:
+        if kv_buffer.shape[1:3] != (1, 1):
+            raise ValueError(f"unsupported KV shape {tuple(kv_buffer.shape)}")
+        kv = kv_buffer.reshape(kv_buffer.shape[0], kv_buffer.shape[3])
+    elif kv_buffer.ndim == 3:
+        kv = kv_buffer.reshape(-1, kv_buffer.shape[-1])
+    elif kv_buffer.ndim == 2:
+        kv = kv_buffer
+    else:
+        raise ValueError(f"unsupported KV shape {tuple(kv_buffer.shape)}")
+    if kv.shape[1] != kv_lora_rank or kv.stride(1) != 1:
+        raise ValueError("gfx1201 sparse MLA needs contiguous 512-element KV rows")
+
+    fp8_kv = kv.dtype in _FP8_DTYPES
+    if fp8_kv:
+        if kv_scale is None or kv_scale.dtype != torch.float32 or kv_scale.numel() != 1:
+            raise ValueError("FP8 KV requires one float32 kv_scale")
+        kv_scale_arg = kv_scale.reshape(1).contiguous()
+    elif kv.dtype == torch.bfloat16:
+        kv_scale_arg = torch.empty(1, dtype=torch.float32, device=q.device)
+    else:
+        raise ValueError(f"unsupported KV dtype {kv.dtype}")
+
+    indices = _as_i32_1d(kv_indices)
+    indptr = _as_i32_1d(kv_indptr)
+    c, h, d = q.shape
+    if indptr.numel() != c + 1:
+        raise ValueError(f"indptr must have {c + 1} elements")
+
+    block_h = 16
+    block_d = 512
+    block_k = 16
+    num_warps = 4
+    heads_blocks = triton.cdiv(h, block_h)
+    average_topk = indices.numel() / max(1, c)
+    max_splits = max(1, math.ceil(average_topk / block_k))
+    if kv_splits is None:
+        occupancy_splits = max(1, 256 // max(1, c * heads_blocks))
+        split_limit = min(32, max_splits, triton.next_power_of_2(occupancy_splits))
+    else:
+        split_limit = min(max_splits, max(1, int(kv_splits)))
+    # The reducer requires a power-of-two split count, but rounding upward can
+    # exceed max_splits and leave an unwritten partial buffer. Round down.
+    splits = 1 << (split_limit.bit_length() - 1)
+
+    if out is None:
+        out = torch.empty((c, h, d), dtype=torch.bfloat16, device=q.device)
+    elif out.shape[:2] != (c, h) or out.shape[2] < d:
+        raise ValueError(f"out shape {tuple(out.shape)} is incompatible with {(c, h, d)}")
+
+    if splits == 1:
+        m_partial = l_partial = acc_partial = out
+        mp = lp = (0, 0, 0)
+        ap = (0, 0, 0, 0)
+    else:
+        m_partial = torch.empty((c, splits, h), dtype=torch.float32, device=q.device)
+        l_partial = torch.empty_like(m_partial)
+        acc_partial = torch.empty(
+            (c, splits, h, d), dtype=torch.bfloat16, device=q.device
+        )
+        mp = m_partial.stride()
+        lp = l_partial.stride()
+        ap = acc_partial.stride()
+
+    _sparse_mla_gfx1201[(c, heads_blocks, splits)](
+        q,
+        kv,
+        kv_scale_arg,
+        indices,
+        indptr,
