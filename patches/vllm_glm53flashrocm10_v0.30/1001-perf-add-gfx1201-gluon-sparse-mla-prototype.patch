@@ -0,0 +1,310 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2024-2026, Advanced Micro Devices, Inc. All rights reserved.
+
+"""Wave32/WMMA sparse MLA kernels for gfx1201.
+
+This is intentionally a rope-free GLM-5.3 kernel.  Unlike the gfx950 kernel,
+it does not use CDNA buffer instructions, MFMA, or wave64 layouts.  Gather is
+synchronous for the first RDNA4 implementation; the split-K grid supplies
+enough independent work to hide memory latency during decode.
+"""
+
+import triton.language as tl
+from triton.experimental import gluon
+from triton.experimental.gluon import language as gl
+
+from aiter.ops.triton.utils._triton.kernel_repr import make_kernel_repr
+
+
+_sparse_mla_repr = make_kernel_repr(
+    "_sparse_mla_gfx1201",
+    ["BLOCK_H", "BLOCK_D", "BLOCK_K", "H", "D", "KV_SPLITS"],
+)
+
+
+@gluon.jit(repr=_sparse_mla_repr)
+def _sparse_mla_gfx1201(
+    q_ptr,
+    kv_ptr,
+    kv_scale_ptr,
+    kv_indices_ptr,
+    kv_indptr_ptr,
+    out_ptr,
+    m_partial_ptr,
+    l_partial_ptr,
+    acc_partial_ptr,
+    q_stride_t: gl.constexpr,
+    q_stride_h: gl.constexpr,
+    q_stride_d: gl.constexpr,
+    kv_stride_n: gl.constexpr,
+    kv_stride_d: gl.constexpr,
+    out_stride_t: gl.constexpr,
+    out_stride_h: gl.constexpr,
+    out_stride_d: gl.constexpr,
+    mp_stride_t: gl.constexpr,
+    mp_stride_s: gl.constexpr,
+    mp_stride_h: gl.constexpr,
+    lp_stride_t: gl.constexpr,
+    lp_stride_s: gl.constexpr,
+    lp_stride_h: gl.constexpr,
+    ap_stride_t: gl.constexpr,
+    ap_stride_s: gl.constexpr,
+    ap_stride_h: gl.constexpr,
+    ap_stride_d: gl.constexpr,
+    num_kv,
+    H: gl.constexpr,
+    D: gl.constexpr,
+    KV_SPLITS: gl.constexpr,
+    softmax_scale: gl.constexpr,
+    FP8_KV: gl.constexpr,
+    BLOCK_H: gl.constexpr,
+    BLOCK_D: gl.constexpr,
+    BLOCK_K: gl.constexpr,
+    num_warps: gl.constexpr,
+):
+    """One query/head tile and one contiguous split of its sparse KV list."""
+    WARP_SIZE: gl.constexpr = 32
+
+    if num_warps == 1:
+        qk_warp_bases: gl.constexpr = []
+        pv_warp_bases: gl.constexpr = []
+    elif num_warps == 2:
+        qk_warp_bases: gl.constexpr = [[1, 0]]
+        pv_warp_bases: gl.constexpr = [[0, 1]]
+    else:
+        qk_warp_bases: gl.constexpr = [[1, 0], [2, 0]]
+        pv_warp_bases: gl.constexpr = [[0, 1], [0, 2]]
+
+    qk_layout: gl.constexpr = gl.amd.AMDWMMALayout(
+        version=3,
+        transposed=True,
+        instr_shape=[16, 16, 32],
+        warp_bases=qk_warp_bases,
+    )
+    pv_layout: gl.constexpr = gl.amd.AMDWMMALayout(
+        version=3,
+        transposed=True,
+        instr_shape=[16, 16, 32],
+        warp_bases=pv_warp_bases,
+    )
+    dot_q_layout: gl.constexpr = gl.DotOperandLayout(
+        operand_index=0, parent=qk_layout, k_width=8
+    )
+    dot_k_layout: gl.constexpr = gl.DotOperandLayout(
+        operand_index=1, parent=qk_layout, k_width=8
+    )
+    dot_p_layout: gl.constexpr = gl.DotOperandLayout(
+        operand_index=0, parent=pv_layout, k_width=8
+    )
+    dot_v_layout: gl.constexpr = gl.DotOperandLayout(
+        operand_index=1, parent=pv_layout, k_width=8
+    )
+
+    d_inner: gl.constexpr = BLOCK_D // 8
+    qkv_warps_h: gl.constexpr = 2 if num_warps >= 2 else 1
+    qkv_warps_d: gl.constexpr = num_warps // qkv_warps_h
+    blocked_layout: gl.constexpr = gl.BlockedLayout(
+        size_per_thread=[1, 8],
+        threads_per_warp=[WARP_SIZE // (d_inner // 2), d_inner // 2],
+        warps_per_cta=[qkv_warps_h, qkv_warps_d],
+        order=[1, 0],
+    )
+    row_layout: gl.constexpr = gl.SliceLayout(1, blocked_layout)
+    col_layout: gl.constexpr = gl.SliceLayout(0, blocked_layout)
+    score_row_layout: gl.constexpr = gl.SliceLayout(1, qk_layout)
+    score_col_layout: gl.constexpr = gl.SliceLayout(0, qk_layout)
+
+    t = gl.program_id(0)
+    pid_h = gl.program_id(1)
+    pid_s = gl.program_id(2)
+    h_base = pid_h * BLOCK_H
+
+    h_offs = gl.arange(0, BLOCK_H, layout=row_layout)
+    d_offs = gl.arange(0, BLOCK_D, layout=col_layout)
+    h_eff = h_base + h_offs
+    h_mask = h_eff < H
+    q = gl.load(
+        q_ptr
+        + t * q_stride_t
+        + h_eff[:, None] * q_stride_h
+        + d_offs[None, :] * q_stride_d,
+        mask=h_mask[:, None],
+        other=0.0,
+        cache_modifier=".cg",
+    )
+    q_dot = gl.convert_layout(q, dot_q_layout)
+
+    kv_start = gl.load(kv_indptr_ptr + t)
+    kv_end = gl.load(kv_indptr_ptr + t + 1)
+    kv_len = kv_end - kv_start
+    num_tiles = gl.cdiv(kv_len, BLOCK_K)
+    tiles_per_split = gl.cdiv(num_tiles, KV_SPLITS)
+    tile_lo = pid_s * tiles_per_split
+    tile_hi = gl.minimum(tile_lo + tiles_per_split, num_tiles)
+    if tile_lo >= tile_hi:
+        return
+
+    m_i = gl.full([BLOCK_H], float("-inf"), gl.float32, layout=score_row_layout)
+    l_i = gl.full([BLOCK_H], 0.0, gl.float32, layout=score_row_layout)
+    acc = gl.zeros([BLOCK_H, BLOCK_D], dtype=gl.float32, layout=pv_layout)
+
+    kv_layout: gl.constexpr = blocked_layout
+    kv_row_layout: gl.constexpr = gl.SliceLayout(1, kv_layout)
+    kv_col_layout: gl.constexpr = gl.SliceLayout(0, kv_layout)
+    k_offs = gl.arange(0, BLOCK_K, layout=kv_row_layout)
+    kv_d_offs = gl.arange(0, BLOCK_D, layout=kv_col_layout)
+
+    for tile in tl.range(tile_lo, tile_hi):
+        k_pos = tile * BLOCK_K + k_offs
+        in_range = k_pos < kv_len
+        slot = gl.load(
+            kv_indices_ptr + kv_start + k_pos,
+            mask=in_range,
+            other=-1,
+            cache_modifier=".cg",
+        )
+        valid = in_range & (slot >= 0) & (slot < num_kv)
+        safe_slot = gl.where(valid, slot, 0)
+        kv = gl.load(
+            kv_ptr
+            + safe_slot[:, None].to(gl.int64) * kv_stride_n
+            + kv_d_offs[None, :] * kv_stride_d,
+            mask=valid[:, None],
+            other=0.0,
+            cache_modifier=".cg",
+        )
+        if FP8_KV:
+            kv_scale = gl.load(kv_scale_ptr).to(gl.float32)
+            kv = (kv.to(gl.float32) * kv_scale).to(gl.bfloat16)
+
+        k_dot = gl.convert_layout(kv.permute(1, 0), dot_k_layout)
+        scores = gl.amd.rdna4.wmma(
+            q_dot,
+            k_dot,
+            gl.zeros([BLOCK_H, BLOCK_K], dtype=gl.float32, layout=qk_layout),
+        )
+        scores = scores * softmax_scale
+        valid_col = gl.convert_layout(valid, score_col_layout)
+        scores = gl.where(valid_col[None, :], scores, float("-inf"))
+
+        m_block = gl.max(scores, axis=1)
+        m_new = gl.maximum(m_i, m_block)
+        alpha = gl.exp(m_i - m_new)
+        p = gl.exp(scores - m_new[:, None])
+        p = gl.where(valid_col[None, :], p, 0.0)
+        l_i = l_i * alpha + gl.sum(p, axis=1)
+
+        p_dot = gl.convert_layout(p.to(gl.bfloat16), dot_p_layout)
+        v_dot = gl.convert_layout(kv, dot_v_layout)
+        acc = acc * gl.convert_layout(alpha[:, None], pv_layout)
+        acc = gl.amd.rdna4.wmma(p_dot, v_dot, acc)
+        m_i = m_new
+
+    m_store = gl.convert_layout(m_i, row_layout)
+    l_store = gl.convert_layout(l_i, row_layout)
+    acc_store = gl.convert_layout(acc, blocked_layout)
+    if KV_SPLITS == 1:
+        denom = gl.convert_layout(l_i[:, None], pv_layout)
+        out_value = gl.convert_layout(acc / gl.maximum(denom, 1.0e-30), blocked_layout)
+        gl.store(
+            out_ptr
+            + t * out_stride_t
+            + h_eff[:, None] * out_stride_h
+            + d_offs[None, :] * out_stride_d,
+            out_value.to(out_ptr.dtype.element_ty),
+            mask=h_mask[:, None],
+        )
+    else:
+        gl.store(
+            m_partial_ptr
+            + t * mp_stride_t
+            + pid_s * mp_stride_s
+            + h_eff * mp_stride_h,
+            m_store,
+            mask=h_mask,
+        )
+        gl.store(
+            l_partial_ptr
+            + t * lp_stride_t
+            + pid_s * lp_stride_s
+            + h_eff * lp_stride_h,
+            l_store,
+            mask=h_mask,
+        )
+        gl.store(
+            acc_partial_ptr
+            + t * ap_stride_t
+            + pid_s * ap_stride_s
+            + h_eff[:, None] * ap_stride_h
+            + d_offs[None, :] * ap_stride_d,
+            acc_store.to(acc_partial_ptr.dtype.element_ty),
+            mask=h_mask[:, None],
+        )
+
+
+@gluon.jit
+def _sparse_mla_reduce_gfx1201(
+    m_partial_ptr,
+    l_partial_ptr,
+    acc_partial_ptr,
+    out_ptr,
+    mp_stride_t: gl.constexpr,
+    mp_stride_s: gl.constexpr,
+    mp_stride_h: gl.constexpr,
+    lp_stride_t: gl.constexpr,
+    lp_stride_s: gl.constexpr,
+    lp_stride_h: gl.constexpr,
+    ap_stride_t: gl.constexpr,
+    ap_stride_s: gl.constexpr,
+    ap_stride_h: gl.constexpr,
+    ap_stride_d: gl.constexpr,
+    out_stride_t: gl.constexpr,
+    out_stride_h: gl.constexpr,
+    out_stride_d: gl.constexpr,
+    H: gl.constexpr,
+    D: gl.constexpr,
+    KV_SPLITS: gl.constexpr,
+    BLOCK_D: gl.constexpr,
+    num_warps: gl.constexpr,
+):
+    """Combine split softmax state; one program handles one output D tile."""
+    layout: gl.constexpr = gl.BlockedLayout(
+        size_per_thread=[1],
+        threads_per_warp=[32],
+        warps_per_cta=[num_warps],
+        order=[0],
+    )
+    t = gl.program_id(0)
+    h = gl.program_id(1)
+    d = gl.program_id(2) * BLOCK_D + gl.arange(0, BLOCK_D, layout=layout)
+    d_mask = d < D
+
+    m_max = gl.full([BLOCK_D], float("-inf"), gl.float32, layout=layout)
+    for s in range(KV_SPLITS):
+        m_s = gl.load(m_partial_ptr + t * mp_stride_t + s * mp_stride_s + h * mp_stride_h)
+        m_max = gl.maximum(m_max, m_s)
+
+    denom = gl.zeros([BLOCK_D], gl.float32, layout=layout)
+    acc = gl.zeros([BLOCK_D], gl.float32, layout=layout)
+    for s in range(KV_SPLITS):
+        m_s = gl.load(m_partial_ptr + t * mp_stride_t + s * mp_stride_s + h * mp_stride_h)
+        l_s = gl.load(l_partial_ptr + t * lp_stride_t + s * lp_stride_s + h * lp_stride_h)
+        weight = gl.where(m_s == float("-inf"), 0.0, gl.exp(m_s - m_max))
+        denom += weight * l_s
+        a_s = gl.load(
+            acc_partial_ptr
+            + t * ap_stride_t
+            + s * ap_stride_s
+            + h * ap_stride_h
+            + d * ap_stride_d,
+            mask=d_mask,
+            other=0.0,
+        ).to(gl.float32)
+        acc += weight * a_s
+
+    result = gl.where(denom > 0.0, acc / gl.maximum(denom, 1.0e-30), 0.0)
+    gl.store(
+        out_ptr + t * out_stride_t + h * out_stride_h + d * out_stride_d,
+        result.to(out_ptr.dtype.element_ty),
+        mask=d_mask,
+    )
