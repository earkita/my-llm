+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Correctness tests for the RDNA4 packed MXFP4 decode GEMV."""
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+from vllm.model_executor.kernels.linear.mxfp4.rocm_gemv import (
+    rocm_mxfp4_row_gemv,
+)
+from vllm.model_executor.layers.quantization.utils.mxfp4_utils import (
+    dequant_mxfp4,
+    downcast_to_mxfp,
+)
+from vllm.platforms import current_platform
+from vllm.utils.import_utils import has_quark
+
+if not current_platform.is_rocm():
+    pytest.skip("packed MXFP4 GEMV is ROCm-only", allow_module_level=True)
+
+from vllm.platforms.rocm import on_rdna4
+
+pytestmark = [
+    pytest.mark.skipif(not on_rdna4(), reason="packed MXFP4 GEMV targets RDNA4"),
+    pytest.mark.skipif(not has_quark(), reason="amd-quark reference is required"),
+]
+
+
+@pytest.mark.parametrize("shape", [(1, 64, 256), (4, 96, 512)])
+def test_rocm_mxfp4_row_gemv_dense(shape: tuple[int, int, int]) -> None:
+    rows, output_size, input_size = shape
+    torch.manual_seed(7)
+    x = torch.randn((rows, input_size), device="cuda", dtype=torch.bfloat16) * 0.2
+    source_weight = (
+        torch.randn((output_size, input_size), device="cuda", dtype=torch.bfloat16)
+        * 0.2
+    )
+    bias = torch.randn((output_size,), device="cuda", dtype=torch.bfloat16) * 0.1
+    weight, weight_scale, _ = downcast_to_mxfp(source_weight, axis=-1)
+
+    actual = rocm_mxfp4_row_gemv(
+        x,
+        weight,
+        weight_scale,
+        bias=bias,
+    )
+    expected = F.linear(
+        x,
+        dequant_mxfp4(weight, weight_scale, torch.bfloat16),
+        bias,
+    )
+
+    torch.testing.assert_close(actual, expected, atol=0.0625, rtol=0.02)
+
+
+def test_rocm_mxfp4_row_gemv_expert_routing() -> None:
+    rows, experts, topk, output_size, input_size = 2, 3, 2, 64, 256
+    torch.manual_seed(11)
+    x = torch.randn((rows, input_size), device="cuda", dtype=torch.bfloat16) * 0.2
+    source_weight = (
+        torch.randn(
+            (experts, output_size, input_size),
+            device="cuda",
+            dtype=torch.bfloat16,
+        )
+        * 0.2
+    )
+    bias = (
+        torch.randn((experts, output_size), device="cuda", dtype=torch.bfloat16) * 0.1
+    )
+    weight, weight_scale, _ = downcast_to_mxfp(source_weight, axis=-1)
+    expert_ids = torch.tensor([0, 2, 1, -1], device="cuda", dtype=torch.int64)
+    route_weights = torch.tensor(
+        [0.25, 0.75, 0.6, 0.4], device="cuda", dtype=torch.float32
+    )
+
+    actual = rocm_mxfp4_row_gemv(
+        x,
+        weight,
+        weight_scale,
+        expert_ids=expert_ids,
+        route_weights=route_weights,
+        bias=bias,
+        routes_per_input=topk,
+    )
+
+    dequantized = dequant_mxfp4(weight, weight_scale, torch.bfloat16)
+    reference_routes = []
+    for route, expert in enumerate(expert_ids.tolist()):
+        if expert < 0:
+            reference_routes.append(
+                torch.zeros(output_size, device="cuda", dtype=torch.bfloat16)
+            )
+        else:
+            value = F.linear(x[route // topk], dequantized[expert], bias[expert])
+            reference_routes.append(value * route_weights[route])
+    expected = torch.stack(reference_routes)
+
+    torch.testing.assert_close(actual, expected, atol=0.0625, rtol=0.02)
+
+
+@torch.inference_mode()
+def test_rocm_mxfp4_gemv_moe_matches_emulation(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    from vllm.config import VllmConfig, set_current_vllm_config
+    from vllm.model_executor.layers.fused_moe import FusedMoEConfig
+    from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+    from vllm.model_executor.layers.fused_moe.config import (
+        FusedMoEParallelConfig,
+        RoutingMethodType,
+        ocp_mx_moe_quant_config,
+    )
+    from vllm.model_executor.layers.fused_moe.experts.ocp_mx_emulation_moe import (
+        OCP_MXQuantizationEmulationTritonExperts,
+    )
+    from vllm.model_executor.layers.fused_moe.oracle.mxfp4 import (
+        Mxfp4MoeBackend,
+        make_mxfp4_moe_kernel,
+    )
+    from vllm.model_executor.layers.quantization.utils.mxfp4_utils import (
+        mxfp4_quantize,
+    )
+    from vllm.v1.worker.workspace import init_workspace_manager
+
+    init_workspace_manager(torch.accelerator.current_device_index())
+    num_tokens, num_experts, topk = 2, 4, 2
+    hidden_size, intermediate_size = 256, 256
+    dtype, device = torch.bfloat16, "cuda:0"
+
+    torch.manual_seed(17)
+    w1, w1_scale = mxfp4_quantize(
+        torch.randn(
+            num_experts,
+            2 * intermediate_size,
+            hidden_size,
+            dtype=dtype,
+            device=device,
+        )
+        / 8
+    )
+    w2, w2_scale = mxfp4_quantize(
+        torch.randn(
+            num_experts,
+            hidden_size,
+            intermediate_size,
+            dtype=dtype,
+            device=device,
+        )
+        / 8
+    )
+    hidden_states = torch.randn(num_tokens, hidden_size, dtype=dtype, device=device)
+    topk_weights, topk_ids = torch.topk(
+        torch.randn(num_tokens, num_experts, device=device), k=topk, dim=-1
+    )
+    topk_weights = torch.softmax(topk_weights, dim=-1).to(dtype)
+    topk_ids = topk_ids.to(torch.int32)
+    moe_config = FusedMoEConfig(
+        num_experts=num_experts,
+        experts_per_token=topk,
+        hidden_dim=hidden_size,
+        intermediate_size=intermediate_size,
+        num_local_experts=num_experts,
+        num_logical_experts=num_experts,
+        moe_parallel_config=FusedMoEParallelConfig.make_no_parallel(),
+        activation=MoEActivation.SILU,
+        in_dtype=dtype,
+        device=device,
+        routing_method=RoutingMethodType.Renormalize,
+    )
+
+    def run(use_packed_gemv: bool) -> torch.Tensor:
+        monkeypatch.setenv(
+            "VLLM_ROCM_USE_TRITON_MXFP4_GEMV",
+            "1" if use_packed_gemv else "0",
+        )
+        quant_config = ocp_mx_moe_quant_config(
+            quant_dtype="mxfp4",
+            weight_dtype="mxfp4",
+            w1_scale=w1_scale,
+            w2_scale=w2_scale,
+        )
+        with set_current_vllm_config(VllmConfig()):
+            kernel = make_mxfp4_moe_kernel(
+                moe_quant_config=quant_config,
+                moe_config=moe_config,
+                mxfp4_backend=Mxfp4MoeBackend.EMULATION,
+                experts_cls=OCP_MXQuantizationEmulationTritonExperts,
+                routing_tables=None,
+            )
+            assert kernel.fused_experts.use_rocm_gemv is use_packed_gemv
+            return kernel.apply(
+                hidden_states=hidden_states,
+                w1=w1,
+                w2=w2,
+                topk_weights=topk_weights,
+                topk_ids=topk_ids,
+                activation=MoEActivation.SILU,
+                global_num_experts=num_experts,
+                expert_map=None,
+                apply_router_weight_on_input=False,
+            ).clone()
+
+    expected = run(False)
+    actual = run(True)
+
+    torch.testing.assert_close(actual, expected, atol=0.125, rtol=0.04)
