+def rocm_mxfp4_row_gemv(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    *,
+    expert_ids: torch.Tensor | None = None,
+    route_weights: torch.Tensor | None = None,
+    bias: torch.Tensor | None = None,
+    routes_per_input: int = 1,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Apply packed row-major MXFP4 weights without full dequantization."""
+    output_size = weight.shape[-2]
+    routes = x.shape[0] * routes_per_input
+    if out is None:
+        out = torch.empty((routes, output_size), dtype=x.dtype, device=x.device)
