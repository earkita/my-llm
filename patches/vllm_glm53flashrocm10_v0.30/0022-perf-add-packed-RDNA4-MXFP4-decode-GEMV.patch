diff --git a/vllm/model_executor/kernels/linear/mxfp4/rocm_gemv.py b/vllm/model_executor/kernels/linear/mxfp4/rocm_gemv.py
new file mode 100644
index 0000000..3205dcf
--- /dev/null
+++ b/vllm/model_executor/kernels/linear/mxfp4/rocm_gemv.py
@@ -0,0 +1,339 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Packed MXFP4 GEMV for small-batch ROCm inference.
+
+The decode path is bandwidth bound and does not benefit from materializing an
+entire BF16 expert matrix before every GEMM.  This kernel reads the checkpoint's
+row-major E2M1 weights and E8M0 block scales directly, expands only the values
+used by the selected rows, and accumulates in FP32.
+
+The implementation is intentionally limited to GEMV-sized batches.  Larger
+batches continue to use the regular emulation GEMM until a separately tuned
+RDNA4 prefill kernel is qualified.  The design follows the public Apache-2.0
+FreeToken MXFP4 split-K decode work, adapted here for vLLM's native Quark weight
+layout and expert-parallel routing.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from vllm.triton_utils import tl, triton
+from vllm.utils.torch_utils import direct_register_custom_op
+
+ROCM_MXFP4_GEMV_MAX_ROWS = 16
+ROCM_MXFP4_GEMV_MAX_ROUTES = 64
+_MXFP4_GROUP_SIZE = 32
+_PACK_FACTOR = 2
+
+
+@triton.jit
+def _e2m1_to_f32(nibble):
+    payload = nibble & 0x7
+    magnitude = tl.where(
+        payload == 0,
+        0.0,
+        tl.where(
+            payload == 1,
+            0.5,
+            tl.where(
+                payload == 2,
+                1.0,
+                tl.where(
+                    payload == 3,
+                    1.5,
+                    tl.where(
+                        payload == 4,
+                        2.0,
+                        tl.where(payload == 5, 3.0, tl.where(payload == 6, 4.0, 6.0)),
+                    ),
+                ),
+            ),
+        ),
+    )
+    return tl.where((nibble & 0x8) != 0, -magnitude, magnitude)
+
+
+@triton.jit
+def _e8m0_to_f32(scale):
+    # E8M0 uses the byte as an IEEE-754 exponent.  255 is reserved; clamp it
+    # so malformed data cannot manufacture a NaN in the accumulator.
+    exponent = tl.minimum(scale.to(tl.int32), 254)
+    return (exponent << 23).to(tl.float32, bitcast=True)
+
+
+@triton.jit
+def _rocm_mxfp4_row_gemv_kernel(
+    x_ptr,
+    weight_ptr,
+    weight_scale_ptr,
+    expert_ids_ptr,
+    route_weights_ptr,
+    bias_ptr,
+    out_ptr,
+    K: tl.constexpr,
+    num_experts,
+    routes_per_input: tl.constexpr,
+    stride_xm,
+    stride_xk,
+    stride_we,
+    stride_wn,
+    stride_wk,
+    stride_wse,
+    stride_wsn,
+    stride_wsk,
+    stride_be,
+    stride_bn,
+    stride_om,
+    stride_on,
+    HAS_EXPERT_IDS: tl.constexpr,
+    HAS_ROUTE_WEIGHTS: tl.constexpr,
+    HAS_BIAS: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    route = tl.program_id(0).to(tl.int64)
+    out_col = tl.program_id(1).to(tl.int64)
+
+    expert = tl.load(expert_ids_ptr + route).to(tl.int64) if HAS_EXPERT_IDS else 0
+    valid_expert = (expert >= 0) & (expert < num_experts)
+    safe_expert = tl.maximum(expert, 0)
+    input_row = route // routes_per_input
+
+    offsets = tl.arange(0, BLOCK_K)
+    acc = tl.zeros((BLOCK_K,), dtype=tl.float32)
+    for k_start in range(0, K, BLOCK_K):
+        k = k_start + offsets
+        valid_k = k < K
+        packed = tl.load(
+            weight_ptr
+            + safe_expert * stride_we
+            + out_col * stride_wn
+            + (k // 2) * stride_wk,
+            mask=valid_expert & valid_k,
+            other=0,
+        ).to(tl.int32)
+        nibble = tl.where((k & 1) == 0, packed & 0xF, (packed >> 4) & 0xF)
+        scale = tl.load(
+            weight_scale_ptr
+            + safe_expert * stride_wse
+            + out_col * stride_wsn
+            + (k // 32) * stride_wsk,
+            mask=valid_expert & valid_k,
+            other=0,
+        )
+        x = tl.load(
+            x_ptr + input_row * stride_xm + k * stride_xk,
+            mask=valid_expert & valid_k,
+            other=0.0,
+        ).to(tl.float32)
+        acc += x * _e2m1_to_f32(nibble) * _e8m0_to_f32(scale)
+
+    value = tl.sum(acc, axis=0)
+    if HAS_BIAS:
+        value += tl.load(
+            bias_ptr + safe_expert * stride_be + out_col * stride_bn,
+            mask=valid_expert,
+            other=0.0,
+        ).to(tl.float32)
+    if HAS_ROUTE_WEIGHTS:
+        value *= tl.load(route_weights_ptr + route).to(tl.float32)
+    value = tl.where(valid_expert, value, 0.0)
+    tl.store(out_ptr + route * stride_om + out_col * stride_on, value)
+
+
+def _normalize_weight_strides(
+    tensor: torch.Tensor,
+) -> tuple[int, int, int, int]:
+    if tensor.ndim == 2:
+        return 1, 0, tensor.stride(0), tensor.stride(1)
+    if tensor.ndim == 3:
+        return tensor.shape[0], tensor.stride(0), tensor.stride(1), tensor.stride(2)
+    raise ValueError(f"MXFP4 GEMV weights must be 2D or 3D, got {tensor.shape}")
+
+
+def _normalize_bias_strides(
+    bias: torch.Tensor | None,
+) -> tuple[int, int]:
+    if bias is None:
+        return 0, 0
+    if bias.ndim == 1:
+        return 0, bias.stride(0)
+    if bias.ndim == 2:
+        return bias.stride(0), bias.stride(1)
+    raise ValueError(f"MXFP4 GEMV bias must be 1D or 2D, got {bias.shape}")
+
+
+def _rocm_mxfp4_row_gemv(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    expert_ids: torch.Tensor | None,
+    route_weights: torch.Tensor | None,
+    bias: torch.Tensor | None,
+    out: torch.Tensor,
+    routes_per_input: int,
+) -> None:
+    if x.ndim != 2:
+        raise ValueError(f"MXFP4 GEMV input must be 2D, got {x.shape}")
+    if out.ndim != 2:
+        raise ValueError(f"MXFP4 GEMV output must be 2D, got {out.shape}")
+    if weight.dtype != torch.uint8 or weight_scale.dtype != torch.uint8:
+        raise TypeError("MXFP4 GEMV requires uint8 packed weights and E8M0 scales")
+    if x.dtype not in (torch.float16, torch.bfloat16):
+        raise TypeError("MXFP4 GEMV input must be float16 or bfloat16")
+    if out.dtype != x.dtype:
+        raise TypeError("MXFP4 GEMV output dtype must match the input dtype")
+    if not (x.is_cuda and weight.is_cuda and weight_scale.is_cuda and out.is_cuda):
+        raise ValueError("MXFP4 GEMV tensors must reside on the GPU")
+    if not (x.device == weight.device == weight_scale.device == out.device):
+        raise ValueError("MXFP4 GEMV tensors must reside on the same GPU")
+    if routes_per_input < 1:
+        raise ValueError("routes_per_input must be positive")
+
+    routes, output_size = out.shape
+    input_size = x.shape[1]
+    if input_size % _MXFP4_GROUP_SIZE != 0:
+        raise ValueError(
+            f"MXFP4 GEMV input size must be divisible by 32, got {input_size}"
+        )
+    if routes != x.shape[0] * routes_per_input:
+        raise ValueError(
+            f"output has {routes} routes, expected {x.shape[0] * routes_per_input}"
+        )
+    if weight.shape[-2:] != (output_size, input_size // _PACK_FACTOR):
+        raise ValueError(
+            "packed weight shape mismatch: "
+            f"got {weight.shape}, expected (..., {output_size}, {input_size // 2})"
+        )
+    if weight_scale.shape[-2:] != (
+        output_size,
+        input_size // _MXFP4_GROUP_SIZE,
+    ):
+        raise ValueError(
+            "weight scale shape mismatch: "
+            f"got {weight_scale.shape}, expected "
+            f"(..., {output_size}, {input_size // _MXFP4_GROUP_SIZE})"
+        )
+    if expert_ids is not None and expert_ids.numel() != routes:
+        raise ValueError("expert_ids must contain one entry per route")
+    if expert_ids is not None and expert_ids.dtype not in (torch.int32, torch.int64):
+        raise TypeError("expert_ids must use int32 or int64")
+    if expert_ids is not None and not expert_ids.is_contiguous():
+        raise ValueError("expert_ids must be contiguous")
+    if route_weights is not None and route_weights.numel() != routes:
+        raise ValueError("route_weights must contain one entry per route")
