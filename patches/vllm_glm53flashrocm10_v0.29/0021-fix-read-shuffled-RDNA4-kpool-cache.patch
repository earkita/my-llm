 else:
     _ON_GFX942 = False
     _ON_GFX950 = False
+    _ON_RDNA4 = False
 
 
 @functools.cache
@@ -595,6 +596,167 @@ def paged_mqa_logits_module():
     return None
 
 
+@triton.jit
+def _rdna4_fp8_paged_mqa_logits_kernel(
+    q_ptr,
+    kv_cache_ptr,
+    kv_scale_ptr,
+    weights_ptr,
+    output_ptr,
+    context_lens_ptr,
+    block_tables_ptr,
+    q_batch_stride,
+    q_next_stride,
+    q_head_stride,
+    kv_cache_block_stride,
+    kv_scale_block_stride,
+    weights_row_stride,
+    output_row_stride,
+    block_table_stride,
+    max_model_len,
+    block_table_width: tl.constexpr,
+    num_blocks: tl.constexpr,
+    next_n: tl.constexpr,
+    num_heads: tl.constexpr,
+    head_dim: tl.constexpr,
+    block_size: tl.constexpr,
+    context_lens_2d: tl.constexpr,
+    block_tile_size: tl.constexpr,
+    head_tile_size: tl.constexpr,
+):
+    row_idx = tl.program_id(0)
+    logical_block_idx = tl.program_id(1)
+    batch_idx = row_idx // next_n
+    next_idx = row_idx % next_n
+
+    if context_lens_2d:
+        context_len = tl.load(context_lens_ptr + batch_idx * next_n + next_idx)
+    else:
+        final_context_len = tl.load(context_lens_ptr + batch_idx)
+        context_len = final_context_len - next_n + next_idx + 1
+
+    valid_logical_block = logical_block_idx < block_table_width
+    physical_block_idx = tl.load(
+        block_tables_ptr
+        + batch_idx * block_table_stride
+        + logical_block_idx,
+        mask=valid_logical_block,
+        other=-1,
+    )
+    valid_physical_block = (
+        valid_logical_block
+        & (physical_block_idx >= 0)
+        & (physical_block_idx < num_blocks)
+    )
+    safe_block_idx = tl.where(valid_physical_block, physical_block_idx, 0).to(
+        tl.int64
+    )
+
+    head_offsets = tl.arange(0, num_heads)
+    dim_offsets = tl.arange(0, head_dim)
+    q = tl.load(
+        q_ptr
+        + batch_idx * q_batch_stride
+        + next_idx * q_next_stride
+        + head_offsets[:, None] * q_head_stride
+        + dim_offsets[None, :]
+    )
+
+    state_in_block = tl.arange(0, block_size)
+    shuffled_k_offsets = (
+        safe_block_idx * kv_cache_block_stride
+        + (state_in_block[:, None] // block_tile_size)
+        * head_dim
+        * block_tile_size
+        + (state_in_block[:, None] % block_tile_size) * head_tile_size
+        + (dim_offsets[None, :] // head_tile_size)
+        * head_tile_size
+        * block_tile_size
+        + (dim_offsets[None, :] % head_tile_size)
+    )
+    k = tl.load(
+        kv_cache_ptr + shuffled_k_offsets,
+        mask=valid_physical_block,
+        other=0.0,
+    )
+    scores = tl.dot(q, tl.trans(k), out_dtype=tl.float32)
+    scores = tl.maximum(scores, 0.0)
+    weights = tl.load(weights_ptr + row_idx * weights_row_stride + head_offsets)
+    scores = tl.sum(scores * weights[:, None], axis=0)
+    scales = tl.load(
+        kv_scale_ptr
+        + safe_block_idx * kv_scale_block_stride
+        + state_in_block,
+        mask=valid_physical_block,
+        other=0.0,
+    )
+    scores *= scales
+
+    state_offsets = logical_block_idx * block_size + state_in_block
+    valid_state = (
+        valid_physical_block
+        & (state_offsets < context_len)
+        & (state_offsets < max_model_len)
+    )
+    tl.store(
+        output_ptr + row_idx * output_row_stride + state_offsets,
+        scores,
+        mask=valid_state,
+    )
+
+
+def rdna4_fp8_paged_mqa_logits(
+    q_fp8: torch.Tensor,
+    kv_cache_fp8: torch.Tensor,
+    weights: torch.Tensor,
+    context_lens: torch.Tensor,
+    block_tables: torch.Tensor,
+    max_model_len: int,
+) -> torch.Tensor:
+    batch_size, next_n, num_heads, head_dim = q_fp8.shape
+    num_blocks, block_size = kv_cache_fp8.shape[:2]
+    packed_cache = kv_cache_fp8.view(num_blocks, -1)
+    value_elements = block_size * head_dim
+    kv_cache_values = packed_cache[:, :value_elements].view(
+        current_platform.fp8_dtype()
+    )
+    kv_cache_scales = packed_cache[:, value_elements:].view(torch.float32)
+    (output,) = current_workspace_manager().get_simultaneous(
+        ((batch_size * next_n, max_model_len), torch.float32),
+    )
+    output.fill_(float("-inf"))
+    grid = (batch_size * next_n, triton.cdiv(max_model_len, block_size))
+    _rdna4_fp8_paged_mqa_logits_kernel[grid](
+        q_fp8,
+        kv_cache_values,
+        kv_cache_scales,
+        weights,
+        output,
+        context_lens,
+        block_tables,
+        q_fp8.stride(0),
+        q_fp8.stride(1),
+        q_fp8.stride(2),
+        kv_cache_values.stride(0),
+        kv_cache_scales.stride(0),
+        weights.stride(0),
+        output.stride(0),
+        block_tables.stride(0),
+        max_model_len,
+        block_table_width=block_tables.shape[1],
+        num_blocks=num_blocks,
+        next_n=next_n,
+        num_heads=num_heads,
+        head_dim=head_dim,
+        block_size=block_size,
+        context_lens_2d=context_lens.dim() > 1,
+        block_tile_size=16,
+        head_tile_size=16,
+        num_warps=4,
+    )
+    return output
+
+
 def rocm_fp8_paged_mqa_logits(
     q_fp8: torch.Tensor,
     kv_cache_fp8: torch.Tensor,
@@ -635,6 +797,16 @@ def rocm_fp8_paged_mqa_logits(
     if rocm_aiter_ops.is_enabled() or rocm_aiter_ops.is_rdna_aiter_enabled():
         aiter_paged_mqa_logits_module = paged_mqa_logits_module()
 
+    if _ON_RDNA4 and block_size > 1:
+        return rdna4_fp8_paged_mqa_logits(
+            q_fp8,
+            kv_cache_fp8,
+            weights,
+            context_lens,
+            block_tables,
+            max_model_len,
+        )
+
     if aiter_paged_mqa_logits_module is not None:
         if _ON_GFX942 or _ON_GFX950:
             deepgemm_fp8_paged_mqa_logits = (
