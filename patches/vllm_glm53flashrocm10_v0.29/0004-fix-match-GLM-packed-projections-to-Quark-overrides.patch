From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sat, 5 Sep 2026 13:58:54 +0200
Subject: [PATCH 04/16] fix: match GLM packed projections to Quark overrides

---
 vllm/models/glm5next/nvidia/model.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/vllm/models/glm5next/nvidia/model.py b/vllm/models/glm5next/nvidia/model.py
index f724406f..a19ed19f 100644
--- a/vllm/models/glm5next/nvidia/model.py
+++ b/vllm/models/glm5next/nvidia/model.py
@@ -1005,6 +1005,15 @@ class Glm5NextForConditionalGeneration(
     MixtureOfExperts,
     SupportsEagle3,
 ):
+    # GLM5Next fuses the dense and expert MLP gate/up projections in vLLM,
+    # while the Quark checkpoint describes them as separate modules. The
+    # inherited GLM4V mapping lists gate_up_proj as its own shard, causing the
+    # dense-layer FP8 overrides to miss and fall back to global MXFP4.
+    packed_modules_mapping = {
+        "qkv_proj": ["q_proj", "k_proj", "v_proj"],
+        "gate_up_proj": ["gate_proj", "up_proj"],
+    }
+
     # The text model (KDA + dense-MLA + MoE) is a hybrid mamba model. The
     # multimodal wrapper must declare the same interfaces so vLLM treats it as
     # hybrid (auto-aligns mamba/attention block sizes, sizes the mamba state
